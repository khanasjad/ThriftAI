// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// CORE ENTITIES
// ========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String?
  lastName      String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // Authentication
  accounts Account[]
  sessions Session[]

  // User type
  buyer  Buyer?
  seller Seller?

  // Relations
  productComparisons ProductComparison[]
  affiliateClicks    AffiliateClick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ========================================
// BUSINESS ENTITIES
// ========================================

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum BuyerType {
  CASUAL
  FREQUENT
  VIP
  BULK_BUYER
}

enum NotificationFrequency {
  NEVER
  DAILY
  WEEKLY
  MONTHLY
}

model Buyer {
  id          String    @id @default(cuid())
  userId      String    @unique
  firstName   String
  lastName    String
  email       String    @unique
  phone       String?
  dateOfBirth DateTime?
  gender      Gender?

  // Address
  address String?
  city    String?
  state   String?
  zipCode String?
  country String?

  // Preferences
  buyerType             BuyerType             @default(CASUAL)
  notificationFrequency NotificationFrequency @default(WEEKLY)
  receiveNewsletters    Boolean               @default(true)
  receiveSms            Boolean               @default(false)
  receiveDeals          Boolean               @default(true)

  // Metrics
  totalOrders          Int   @default(0)
  totalSpent           Float @default(0.0)
  averageOrderValue    Float @default(0.0)
  loyaltyPoints        Float @default(0.0)
  maxBudget            Float @default(1000.0)
  minDiscountThreshold Float @default(10.0)
  favoriteItems        Int   @default(0)

  // Status
  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  lastOrderAt DateTime?

  // Relations
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders              Order[]
  cartItems           CartItem[]
  reviews             Review[]
  preferredCategories String[]
  preferredBrands     String[]
  preferredSizes      String[]

  @@map("buyers")
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
  ENTERPRISE
}

model Seller {
  id           String  @id @default(cuid())
  userId       String  @unique
  businessName String
  ownerName    String
  email        String  @unique
  phone        String
  address      String
  city         String?
  state        String?
  zipCode      String?

  // Business Details
  sellerType      SellerType @default(INDIVIDUAL)
  businessLicense String?
  paypalEmail     String?
  description     String?

  // Metrics
  totalSales     Int     @default(0)
  totalRevenue   Decimal @default(0.0) @db.Decimal(10, 2)
  rating         Float   @default(0.0)
  commissionRate Float   @default(0.1)

  // Performance Metrics
  responseTimeHours        Float @default(24.0)
  avgShipmentDays          Float @default(3.0)
  onTimeDeliveryRate       Float @default(0.95)
  defectRate               Float @default(0.02)
  customerSatisfactionRate Float @default(0.90)

  // Response tracking
  lastResponseAt       DateTime?
  avgResponseTimeHours Float     @default(12.0)

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  categories String[]

  @@index([rating])
  @@index([isVerified])
  @@index([responseTimeHours])
  @@index([onTimeDeliveryRate])
  @@map("sellers")
}

model Product {
  id            String  @id @default(cuid())
  name          String
  category      String
  brand         String?
  price         Float
  originalPrice Float   @default(0.0)
  condition     String?
  description   String? @db.Text
  imageUrl      String?
  storeId       String?
  size          String?
  isAvailable   Boolean @default(true)

  // Stock & Availability
  stockQuantity     Int @default(0)
  lowStockThreshold Int @default(5)

  // Shipping & Delivery
  shippingCost          Float   @default(0.0)
  estimatedDeliveryDays Int     @default(5)
  hasFreeShipping       Boolean @default(false)
  hasFreeReturns        Boolean @default(false)
  returnPeriodDays      Int     @default(30)
  weight                Float? // in kg
  length                Float? // in cm
  width                 Float? // in cm
  height                Float? // in cm

  // Quality Indicators
  hasWarranty    Boolean  @default(false)
  warrantyMonths Int?
  isAuthentic    Boolean  @default(true)
  certifications String[] @default([])

  // Performance Metrics (updated via triggers/jobs)
  viewCount         Int @default(0)
  clickCount        Int @default(0)
  purchaseCount     Int @default(0)
  cartAdditionCount Int @default(0)
  wishlistCount     Int @default(0)

  // Computed Scores (updated periodically)
  popularityScore Float @default(0.0)
  qualityScore    Float @default(0.0)
  trendingScore   Float @default(0.0)
  relevanceScore  Float @default(0.0)

  // Search Optimization
  searchKeywords String[] @default([])
  tags           String[] @default([])

  // Analytics Timestamps
  lastViewedAt    DateTime?
  lastPurchasedAt DateTime?
  lastCartAddedAt DateTime?

  // Relations
  sellerId    String?
  seller      Seller?             @relation(fields: [sellerId], references: [id])
  orderItems  OrderItem[]
  cartItems   CartItem[]
  reviews     Review[]
  embedding   ProductEmbedding?
  comparisons ProductComparison[]
  analytics   ProductAnalytics[]
  views       ProductView[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performance indexes for search functionality
  @@index([isAvailable])
  @@index([category])
  @@index([brand])
  @@index([condition])
  @@index([size])
  @@index([price])
  @@index([createdAt])
  @@index([category, isAvailable])
  @@index([brand, isAvailable])
  @@index([price, isAvailable])
  @@index([category, brand, isAvailable])
  @@index([name])
  @@index([sellerId])
  // New indexes for performance
  @@index([popularityScore])
  @@index([trendingScore])
  @@index([qualityScore])
  @@index([stockQuantity])
  @@index([hasFreeShipping])
  @@index([lastViewedAt])
  @@index([viewCount])
  @@map("products")
}

model ProductEmbedding {
  productId            String  @id
  nameEmbedding        String? @db.Text
  descriptionEmbedding String? @db.Text
  combinedEmbedding    String? @db.Text
  needsUpdate          Boolean @default(false)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_embeddings")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id        String  @id @default(cuid())
  buyerId   String
  sessionId String?
  subtotal  Float
  tax       Float
  shipping  Float
  total     Float

  // Status
  status               OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(PENDING)
  paymentMethod        String?
  paymentTransactionId String?
  trackingNumber       String?

  // Billing Address
  billingName    String?
  billingAddress String?
  billingCity    String?
  billingState   String?
  billingZip     String?
  billingCountry String?

  // Shipping Address
  shippingName    String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingPhone   String?

  // Notes
  orderNotes String?

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  shippedAt         DateTime?
  deliveredAt       DateTime?
  estimatedDelivery DateTime?

  // Relations
  buyer Buyer       @relation(fields: [buyerId], references: [id])
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  // Product snapshot
  productName      String?
  productCategory  String?
  productBrand     String?
  productCondition String?
  productSize      String?
  productImageUrl  String?
  sellerId         String?

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

model CartItem {
  id          String  @id @default(cuid())
  sessionId   String
  buyerId     String?
  productId   String
  quantity    Int     @default(1)
  priceAtTime Float?

  // Relations
  buyer   Buyer?  @relation(fields: [buyerId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cart_items")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

model Review {
  id        String  @id @default(cuid())
  buyerId   String
  productId String
  title     String
  content   String? @db.Text
  rating    Int // 1-5

  // Detailed ratings
  conditionRating Int? // 1-5
  valueRating     Int? // 1-5
  sellerRating    Int? // 1-5
  shippingRating  Int? // 1-5

  // Metadata
  isVerifiedPurchase Boolean      @default(false)
  helpfulVotes       Int          @default(0)
  unhelpfulVotes     Int          @default(0)
  status             ReviewStatus @default(PENDING)
  moderationNotes    String?

  // Relations
  buyer   Buyer         @relation(fields: [buyerId], references: [id])
  product Product       @relation(fields: [productId], references: [id])
  photos  ReviewPhoto[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  photoUrl String

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_photos")
}

// ========================================
// CONFIGURATION ENTITIES
// ========================================

model CategoryConfiguration {
  id             BigInt  @id @default(autoincrement())
  categoryName   String  @unique @db.VarChar(100)
  parentCategory String? @db.VarChar(100)
  displayName    String  @db.VarChar(200)
  description    String? @db.Text
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  // Relations
  keywords CategoryKeyword[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("category_configuration")
}

model CategoryKeyword {
  id         BigInt  @id @default(autoincrement())
  categoryId BigInt
  keyword    String  @db.VarChar(100)
  synonym    String? @db.VarChar(100)
  weight     Decimal @default(1.0) @db.Decimal(3, 2)
  isActive   Boolean @default(true)

  // Relations
  categoryConfiguration CategoryConfiguration @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([keyword])
  @@index([categoryId, keyword])
  @@map("category_keywords")
}

model SearchExclusionConfiguration {
  id               BigInt  @id @default(autoincrement())
  ruleName         String  @db.VarChar(100)
  searchContext    String  @db.VarChar(100)
  exclusionKeyword String  @db.VarChar(100)
  exclusionType    String  @default("STRICT") @db.VarChar(50)
  categoryId       BigInt?
  isActive         Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([searchContext, exclusionKeyword])
  @@map("search_exclusion_configuration")
}

model SearchKeywordConfiguration {
  id          BigInt            @id @default(autoincrement())
  keywordType SearchKeywordType
  keyword     String            @db.VarChar(100)
  category    String?           @db.VarChar(100)
  synonyms    String[]
  weight      Decimal           @default(1.0) @db.Decimal(3, 2)
  isActive    Boolean           @default(true)
  metadata    Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([keywordType, keyword])
  @@index([keywordType, isActive])
  @@map("search_keyword_configuration")
}

enum SearchKeywordType {
  PRODUCT_TYPE
  BRAND_DESCRIPTOR
  CONDITION_DESCRIPTOR
  STOP_WORD
  MATERIAL
  COLOR
  STYLE
  SEASONAL
}

model BrandConfiguration {
  id             BigInt  @id @default(autoincrement())
  brandName      String  @unique @db.VarChar(100)
  normalizedName String  @db.VarChar(100)
  reputation     Int     @default(70)
  isPremium      Boolean @default(false)
  warranty       String? @db.VarChar(50)
  category       String? @db.VarChar(100)
  isActive       Boolean @default(true)
  metadata       Json?

  // Relations
  keywords BrandKeyword[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([normalizedName])
  @@index([isPremium])
  @@index([reputation])
  @@map("brand_configuration")
}

model BrandKeyword {
  id          BigInt           @id @default(autoincrement())
  brandId     BigInt
  keyword     String           @db.VarChar(100)
  keywordType BrandKeywordType
  weight      Decimal          @default(1.0) @db.Decimal(3, 2)
  isActive    Boolean          @default(true)

  // Relations
  brandConfiguration BrandConfiguration @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([keyword])
  @@index([brandId, keyword])
  @@index([keywordType])
  @@map("brand_keywords")
}

enum BrandKeywordType {
  BRAND_NAME
  VARIANT
  DESIGNER_INDICATOR
  LUXURY_INDICATOR
  QUALITY_INDICATOR
}

model CategoryMappingConfiguration {
  id              BigInt   @id @default(autoincrement())
  categoryName    String   @unique @db.VarChar(100)
  amazonCategory  String   @db.VarChar(100)
  subcategories   String[]
  avgShippingDays Int      @default(3)
  returnWindow    Int      @default(30)
  isActive        Boolean  @default(true)
  metadata        Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryName])
  @@map("category_mapping_configuration")
}

// ========================================
// AFFILIATE PRODUCTS
// ========================================

enum AffiliateSource {
  AMAZON
  EBAY
  ZALANDO
  ASOS
  H_AND_M
  ZARA
  UNIQLO
  NORDSTROM
  MACY
  TARGET
  WALMART
  SHOPIFY
  COMMISSION_JUNCTION
  SHAREASALE
  IMPACT
  RAKUTEN
  OTHER
}

enum Season {
  SPRING
  SUMMER
  FALL
  WINTER
  ALL_SEASON
}

enum TargetGender {
  MALE
  FEMALE
  UNISEX
  KIDS_BOYS
  KIDS_GIRLS
  KIDS_UNISEX
}

model AffiliateProduct {
  id                 String  @id @default(cuid())
  name               String  @db.VarChar(200)
  description        String? @db.Text
  brand              String  @db.VarChar(100)
  category           String  @db.VarChar(100)
  subcategory        String? @db.VarChar(50)
  sku                String  @unique @db.VarChar(100)
  price              Float
  originalPrice      Float?
  discountPercentage Float?

  // Affiliate Info
  affiliateSource  AffiliateSource
  affiliateId      String?         @db.VarChar(100)
  affiliateUrl     String          @db.VarChar(500)
  commissionRate   Float?
  commissionAmount Float?

  // Product Details
  imageUrl     String?       @db.VarChar(500)
  targetGender TargetGender?
  season       Season?
  ageGroup     String?       @db.VarChar(50)

  // Inventory
  inStock       Boolean @default(true)
  stockQuantity Int?

  // SEO
  seoTitle       String? @db.VarChar(200)
  seoDescription String? @db.VarChar(500)

  // Metrics
  rating      Float?
  reviewCount Int     @default(0)
  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)

  // Collections
  colors           String[]
  sizes            String[]
  images           String[]
  keywords         String[]
  tags             String[]
  specifications   Json?
  trendingKeywords String?  @db.Text

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSyncAt    DateTime @default(now())
  dataExpiresAt DateTime

  @@map("affiliate_products")
}

// ========================================
// EXTERNAL MARKETPLACE INTEGRATION
// ========================================

enum ExternalSource {
  AMAZON
  EBAY
  NIKE
  ADIDAS
  WALMART
  TARGET
  SHOPIFY
}

// External marketplace products (cached)
model ExternalProduct {
  id         String         @id @default(cuid())
  source     ExternalSource
  externalId String // Amazon ASIN, eBay Item ID, etc.

  // Product details
  title       String
  description String? @db.Text
  brand       String?
  category    String

  // Pricing
  price         Float
  originalPrice Float?
  currency      String @default("USD")
  shippingCost  Float?

  // Links
  productUrl   String
  affiliateUrl String?
  imageUrl     String?

  // Metadata
  condition    String?
  rating       Float?
  reviewCount  Int     @default(0)
  availability Boolean @default(true)

  // Caching
  cachedAt  DateTime @default(now())
  expiresAt DateTime

  // Relations
  amazonComparisons ProductComparison[] @relation("AmazonProduct")
  ebayComparisons   ProductComparison[] @relation("EbayProduct")

  @@unique([source, externalId])
  @@index([source, externalId])
  @@index([brand, category])
  @@index([cachedAt])
  @@map("external_products")
}

// Price comparisons
model ProductComparison {
  id          String  @id @default(cuid())
  searchQuery String
  userId      String?

  // ThriftAI product (if exists)
  thriftaiProductId String?
  thriftaiProduct   Product? @relation(fields: [thriftaiProductId], references: [id])

  // External matches
  amazonProductId String?
  amazonProduct   ExternalProduct? @relation("AmazonProduct", fields: [amazonProductId], references: [id])

  ebayProductId String?
  ebayProduct   ExternalProduct? @relation("EbayProduct", fields: [ebayProductId], references: [id])

  // Best deal analysis
  bestDealSource   String // 'thriftai', 'amazon', 'ebay', etc.
  bestDealPrice    Float
  estimatedSavings Float

  // Analytics
  userClicked   Boolean @default(false)
  clickedSource String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([searchQuery])
  @@index([userId])
  @@map("product_comparisons")
}

// Affiliate tracking
model AffiliateClick {
  id        String  @id @default(cuid())
  userId    String?
  sessionId String

  // Product info
  source            ExternalSource
  externalProductId String
  productTitle      String

  // Affiliate details
  affiliateUrl String
  referralCode String

  // Financial
  estimatedPrice     Float
  expectedCommission Float?

  // Status
  clicked   Boolean   @default(false)
  clickedAt DateTime?

  converted        Boolean   @default(false)
  convertedAt      DateTime?
  commissionEarned Float?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([source])
  @@index([clicked, converted])
  @@map("affiliate_clicks")
}

// ========================================
// ANALYTICS & PERFORMANCE TRACKING
// ========================================

// Daily aggregated product performance metrics
model ProductAnalytics {
  id        String   @id @default(cuid())
  productId String
  date      DateTime @db.Date

  // Daily metrics
  views         Int @default(0)
  uniqueViews   Int @default(0)
  clicks        Int @default(0)
  cartAdditions Int @default(0)
  purchases     Int @default(0)
  wishlistAdds  Int @default(0)

  // Calculated rates
  clickThroughRate Float @default(0.0)
  conversionRate   Float @default(0.0)
  bounceRate       Float @default(0.0)
  cartAbandonRate  Float @default(0.0)

  // Revenue
  revenue Float @default(0.0)

  // Engagement
  avgTimeOnPageSeconds Float @default(0.0)
  avgScrollDepth       Float @default(0.0)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, date])
  @@index([date])
  @@index([productId, date])
  @@index([views])
  @@index([purchases])
  @@map("product_analytics")
}

// Individual product view tracking
model ProductView {
  id        String  @id @default(cuid())
  productId String
  userId    String?
  sessionId String

  // Context
  source      String // search, category, related, direct, external
  searchQuery String?
  referrer    String?
  position    Int? // Position in search results

  // Engagement
  timeOnPageSeconds Int?
  scrollDepth       Float? // 0-1
  didAddToCart      Boolean @default(false)
  didPurchase       Boolean @default(false)
  didBounce         Boolean @default(false) // <10 seconds

  // Device & Location
  deviceType String? // mobile, tablet, desktop
  browser    String?
  country    String?
  city       String?

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([source])
  @@index([searchQuery])
  @@map("product_views")
}

// Search query tracking for analytics and AI improvement
model SearchQuery {
  id        String  @id @default(cuid())
  query     String
  userId    String?
  sessionId String

  // User context
  userCategory  String? // Inferred user interests
  previousQuery String?

  // Results
  resultCount      Int
  clickedProductId String?
  clickPosition    Int? // Which result was clicked (1st, 2nd, etc)

  // Performance
  responseTimeMs Int
  aiConfidence   Float? // Claude's confidence in understanding the query

  // Engagement
  didClickResult Boolean @default(false)
  didPurchase    Boolean @default(false)
  refinedQuery   String? // If user modified the query

  // Filters applied
  filtersApplied Json?

  createdAt DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([resultCount])
  @@map("search_queries")
}

// User behavior sessions for pattern analysis
model UserSession {
  id        String  @id @default(cuid())
  sessionId String  @unique
  userId    String?

  // Session data
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?

  // Engagement metrics
  pageViews     Int @default(0)
  productViews  Int @default(0)
  searchQueries Int @default(0)
  cartAdditions Int @default(0)
  purchases     Int @default(0)

  // Conversion
  convertedToSale Boolean @default(false)
  totalSpent      Float   @default(0.0)

  // Device & Location
  deviceType String?
  browser    String?
  country    String?
  referrer   String?

  @@index([sessionId])
  @@index([userId])
  @@index([startedAt])
  @@index([convertedToSale])
  @@map("user_sessions")
}
