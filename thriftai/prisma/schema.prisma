/// Veritas Score™ - 8 Quality Categories
///
/// Universal across ALL product conditions (new, refurbished, used, rental)
/// Each category adapted based on product condition for accurate assessment
///
/// PRODUCT_QUALITY (25%): Physical condition, authenticity, functionality
///   - NEW: Packaging, warranty, defect rate
///   - REFURB: Certification level, OEM parts, testing
///   - USED: Actual condition, wear, remaining lifespan
///
/// SELLER_TRUST (20%): Reputation, reliability, customer service
///   - Authorized dealers: Higher baseline score
///   - Certified refurbishers: Certification bonus
///   - Individual sellers: Transaction history-based
///
/// MARKET_VALUE (15%): Price fairness, value for money
///   - NEW: % below MSRP
///   - REFURB: vs. expected depreciation
///   - USED: vs. similar condition items
///
/// SUSTAINABILITY (12%): Environmental impact, circular economy
///   - NEW: Lower score (encourages refurb/used)
///   - REFURB: High score (professional restoration)
///   - USED: Highest score (maximum reuse)
///
/// SECURITY_SAFETY (5%): Payment security, buyer protection
///
/// USER_EXPERIENCE (5%): Listing quality, customer service
///
/// PRODUCT_SPECIFICATION (13%): Category-specific tech specs
///   - Adapts to product category (electronics, fashion, furniture, etc.)
///
/// COMPANY_PERFORMANCE (5%): Brand reputation, news sentiment, market data
enum VeritasCategoryType {
  PRODUCT_QUALITY
  SELLER_TRUST
  MARKET_VALUE
  SUSTAINABILITY
  SECURITY_SAFETY
  USER_EXPERIENCE
  PRODUCT_SPECIFICATION
  COMPANY_PERFORMANCE
}

// ============================================================================
// VERITAS SCORE™ - RELATIONAL DATABASE ARCHITECTURE
// ============================================================================
//
// Complex 8-table system optimized for data reuse and performance:
//
// DATA LEVELS (from shared to unique):
// 1. PLATFORM → all products on same platform
// 2. COMPANY → all products from same brand
// 3. MODEL → all units of same model
// 4. SELLER → all listings from same seller
// 5. PRODUCT → unique per listing
// 6. MARKET → time-series pricing data
//
// PERFORMANCE OPTIMIZATION:
// - Apple stock price: 1 fetch → 10,000 Apple products
// - iPhone 15 Pro specs: 1 fetch → 5,000 units
// - eBay seller data: 1 fetch → 500 listings
// - 99.4% reduction in API calls
//
// See: VERITAS_DATA_LEVEL_ANALYSIS.md for complete documentation
// ============================================================================

/// Table 1: Company Performance Data (Company Level)
/// Cardinality: 1 company → MANY products
/// Update Frequency: Stock data hourly, brand data monthly
/// Data Sources: Alpha Vantage (stock), financial APIs, news APIs
/// Cache Strategy: Stock 1 hour, brand 30 days
model VeritasCompanyProfile {
  id                    String    @id @default(cuid())
  brandName             String    @unique // "Apple", "Sony", "Dell"

  // Brand Reputation (35% of Company Performance)
  brandReputationScore  Decimal   @default(70) @db.Decimal(5, 2) // 0-100
  brandRecognition      Decimal   @default(70) @db.Decimal(5, 2) // % global recognition
  customerLoyaltyIndex  Decimal   @default(70) @db.Decimal(5, 2) // NPS-based

  // Market Performance (25%)
  marketPerformance     Decimal?  @db.Decimal(5, 2) // Growth rate
  stockSymbol           String?   // "AAPL", "SONY", etc.
  stockPrice            Decimal?  @db.Decimal(10, 2)
  stockChange           Decimal?  @db.Decimal(5, 2) // % change
  marketCap             Decimal?  @db.Decimal(15, 2) // USD
  marketShare           Decimal?  @db.Decimal(5, 2) // % of market

  // News & Sentiment (25%)
  newsSentimentScore    Decimal   @default(70) @db.Decimal(5, 2) // -100 to +100
  mediaCoverage         Decimal   @default(70) @db.Decimal(5, 2) // Volume score
  socialSentiment       Decimal   @default(70) @db.Decimal(5, 2) // Social media

  // Public Domain Data (15%)
  publicPresenceScore   Decimal   @default(70) @db.Decimal(5, 2)
  avgReviewScore        Decimal?  @db.Decimal(3, 2) // 0-5 stars
  industryAwards        Int       @default(0)
  esgScore              Decimal?  @db.Decimal(5, 2) // Environmental/Social/Governance
  innovationIndex       Decimal?  @db.Decimal(5, 2)
  globalPresence        Int?      // Countries served

  // Metadata
  lastStockUpdate       DateTime? // Stock data refreshed hourly
  lastBrandUpdate       DateTime? // Brand data refreshed monthly
  dataSourceUrls        Json?     // Links to data sources

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  products              Product[] // All products from this brand

  @@index([brandName])
  @@index([stockSymbol])
  @@index([lastStockUpdate])
  @@map("veritas_company_profiles")
}

/// Table 2: Product Specifications (Model Level)
/// Cardinality: 1 model → MANY units
/// Update Frequency: 90 days (specs rarely change)
/// Data Sources: GSMArena, manufacturer spec sheets
/// Cache Strategy: 90 days (specs are static per model)
model VeritasProductSpec {
  id                    String    @id @default(cuid())
  modelIdentifier       String    @unique // "iPhone_15_Pro_Max_256GB"

  // Model & Version (20% of Product Specification)
  modelName             String    // "iPhone 15 Pro Max"
  modelYear             Int?      // 2024
  variant               String?   // "256GB, Titanium Blue"
  modelNumber           String?   // "A2894"
  regionalVariant       String?   // "US", "EU", "Global"

  // Hardware Details (15% - from GSMArena)
  processor             String?   // "A17 Pro chip"
  processorCores        String?   // "Hexa-core"
  ram                   String?   // "8GB"
  storage               String?   // "256GB"
  displaySize           String?   // "6.7 inches"
  displayResolution     String?   // "2796 x 1290"
  displayType           String?   // "Super Retina XDR"
  displayRefreshRate    String?   // "120Hz ProMotion"
  mainCamera            String?   // "48MP"
  frontCamera           String?   // "12MP"
  batteryCapacity       String?   // "4,422 mAh"
  os                    String?   // "iOS 17"
  connectivity          String?   // "5G, Wi-Fi 6E"
  dimensions            String?   // "160.9 x 77.6 x 8.25 mm"
  weight                String?   // "221 g"
  buildMaterials        String?   // "Titanium frame, glass back"
  waterResistance       String?   // "IP68"

  // Technical Specifications (35%)
  specCompleteness      Decimal   @default(70) @db.Decimal(5, 2) // How complete is spec sheet
  specAccuracy          Decimal   @default(70) @db.Decimal(5, 2) // Verified by manufacturer

  // Category-Specific Features (30%)
  featureMatchScore     Decimal   @default(70) @db.Decimal(5, 2)
  featureCompleteness   Decimal   @default(70) @db.Decimal(5, 2)
  upgradeIndicator      String?   // "Latest", "Mid-range", "Budget"

  // Data sources
  gsmarenaUrl           String?   // Link to GSMArena page
  officialSpecUrl       String?   // Link to manufacturer spec sheet
  dataSourceUrls        Json?     // Additional sources

  lastSpecUpdate        DateTime? // Last time specs were verified
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  products              Product[] // All units of this model

  @@index([modelIdentifier])
  @@index([modelName])
  @@index([modelYear])
  @@map("veritas_product_specs")
}

/// Table 3: Seller Trust Profile (Seller Level)
/// Cardinality: 1 seller → MANY listings
/// Update Frequency: 7 days
