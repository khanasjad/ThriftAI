  // Seller Reputation (40% of Seller Trust)
  sellerRating          Decimal   @default(0) @db.Decimal(3, 2) // 0-5 stars
  transactionCount      Int       @default(0)
  positiveFeedbackPct   Decimal   @default(0) @db.Decimal(5, 2) // 0-100%
