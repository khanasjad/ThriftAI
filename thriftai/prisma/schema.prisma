  isVerified            Boolean   @default(false)
  isTopRated            Boolean   @default(false)
  sellerBadges          String[]  @default([])
  sellerLocation        String?

  // Response & Service (25%)
  avgResponseTimeHours  Decimal?  @db.Decimal(5, 2)
  responseRate          Decimal   @default(0) @db.Decimal(5, 2) // 0-100%
  serviceQualityScore   Decimal   @default(70) @db.Decimal(5, 2)
  communicationScore    Decimal   @default(70) @db.Decimal(5, 2)

  // Transaction History (20%)
  disputeRate           Decimal   @default(0) @db.Decimal(5, 2) // %
  refundRate            Decimal   @default(0) @db.Decimal(5, 2) // %
  chargebackRate        Decimal   @default(0) @db.Decimal(5, 2) // %
  cancellationRate      Decimal   @default(0) @db.Decimal(5, 2) // %
  repeatCustomerRate    Decimal   @default(0) @db.Decimal(5, 2) // %

  // Reliability Indicators (15%)
  onTimeShippingPct     Decimal   @default(0) @db.Decimal(5, 2)
  accurateDescPct       Decimal   @default(0) @db.Decimal(5, 2)
  packagingQuality      Decimal   @default(70) @db.Decimal(5, 2)
  itemAsDescribedPct    Decimal   @default(0) @db.Decimal(5, 2)
  damageRate            Decimal   @default(0) @db.Decimal(5, 2)
  returnRequestRate     Decimal   @default(0) @db.Decimal(5, 2)

  // Composite score
  sellerPerformanceIndex Decimal  @default(70) @db.Decimal(5, 2) // 0-100

  // Data sources
  ebaySellerUrl         String?
  platformProfileUrl    String?
  dataSourceUrls        Json?

  lastDataUpdate        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  products              Product[] // All listings from this seller

  @@index([sellerIdentifier])
  @@index([sellerPlatform])
  @@index([sellerPerformanceIndex])
  @@index([isTopRated])
  @@map("veritas_seller_profiles")
}

/// Table 4: Security & Safety Policies (Platform Level)
/// Cardinality: 1 platform → ALL products
/// Update Frequency: 90 days (policies change rarely)
/// Data Sources: Platform security policies, compliance checks
/// Cache Strategy: 90 days
model VeritasSecurityPolicy {
  id                    String    @id @default(cuid())
  platformName          String    @unique // "ebay", "apple.com", "amazon"

  // Payment Security (40%)
  paymentSecurity       Decimal   @default(70) @db.Decimal(5, 2)
  fraudProtection       Decimal   @default(70) @db.Decimal(5, 2)
  paymentEncryption     Decimal   @default(70) @db.Decimal(5, 2)
  supportedPayments     String[]  @default([]) // ["credit_card", "paypal", "apple_pay"]

  // Buyer Protection (30%)
  buyerProtection       Decimal   @default(70) @db.Decimal(5, 2)
  disputeResolution     Decimal   @default(70) @db.Decimal(5, 2)
  moneyBackGuarantee    Boolean   @default(false)
  maxProtectionAmount   Decimal?  @db.Decimal(10, 2)

  // Data Security (20%)
  dataPrivacy           Decimal   @default(70) @db.Decimal(5, 2)
  deviceSecurity        Decimal   @default(70) @db.Decimal(5, 2)
  gdprCompliant         Boolean   @default(false)
  pciCompliant          Boolean   @default(false)
  sslEncryption         Boolean   @default(true)

  // Platform Trust (10%)
  platformReputation    Decimal   @default(70) @db.Decimal(5, 2)
  platformAge           Int?      // Years in operation
  trustpilotScore       Decimal?  @db.Decimal(3, 2) // 0-5
  bbbRating             String?   // "A+", "A", etc.

  // Policy URLs
  privacyPolicyUrl      String?
  termsOfServiceUrl     String?
  buyerProtectionUrl    String?

  lastPolicyUpdate      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  products              Product[] // All products on this platform

  @@index([platformName])
  @@map("veritas_security_policies")
}

/// Table 5: Product Quality Data (Product Level - Unique per listing)
/// Cardinality: 1 product → 1 quality record
/// Update Frequency: 1 day (condition doesn't change often)
/// Data Sources: Product listing, AI vision, warranty APIs
model VeritasProductQuality {
  id                    String    @id @default(cuid())
  productId             String    @unique

  // Physical Condition (45%)
  conditionScore        Decimal   @default(70) @db.Decimal(5, 2) // 0-100
  visualDefects         Decimal   @default(70) @db.Decimal(5, 2) // AI vision analysis
  functionalCompleteness Decimal  @default(70) @db.Decimal(5, 2)
  wearTearLevel         Decimal   @default(70) @db.Decimal(5, 2)
  missingComponents     Decimal   @default(90) @db.Decimal(5, 2)
  materialQuality       Decimal   @default(70) @db.Decimal(5, 2)

  // Authenticity & Verification (20%)
  authenticationStatus  String?   // "verified", "certified", "unverified"
  serialNumber          String?
  serialVerified        Boolean   @default(false)
  counterfeitRisk       Decimal   @default(0) @db.Decimal(5, 2) // 0-100 (lower is better)
  documentationComplete Boolean   @default(false)
  imeiVerified          Boolean?  // For phones

  // Functional Testing (15%)
  hardwareFunctionality Decimal   @default(70) @db.Decimal(5, 2)
  softwarePerformance   Decimal   @default(70) @db.Decimal(5, 2)
  batteryHealth         Decimal?  @db.Decimal(5, 2) // 0-100%
  screenQuality         Decimal?  @db.Decimal(5, 2)
  cameraFunctionality   Decimal?  @db.Decimal(5, 2)

  // Age & History (10%)
  productAgeDays        Int?
  usageHours            Int?
  previousOwnerCount    Int?
  repairHistory         Json?     // Array of repairs
  manufacturingDate     DateTime?

  // Warranty & Support (10%)
  warrantyStatus        String?   // "active", "expired", "n/a"
  warrantyMonths        Int?
  warrantyProvider      String?   // "manufacturer", "seller", "third_party"
  returnPolicyDays      Int?
  supportAvailability   Decimal   @default(70) @db.Decimal(5, 2)

  // AI Analysis
  photoAnalysisScore    Decimal?  @db.Decimal(5, 2) // AI vision confidence
  descriptionNLPScore   Decimal?  @db.Decimal(5, 2) // NLP analysis

  // Data sources
  warrantyApiData       Json?     // Apple/Dell API response
  aiVisionReport        Json?     // Vision AI analysis

  lastQualityCheck      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([authenticationStatus])
  @@index([warrantyStatus])
  @@map("veritas_product_quality")
}

/// Table 6: Market Data (Time-Series - Multiple records per product)
/// Cardinality: 1 product → MANY snapshots
/// Update Frequency: 1 hour (pricing changes frequently)
/// Data Sources: eBay market data, price tracking APIs
model VeritasMarketData {
  id                    String    @id @default(cuid())
  productId             String
  snapshotDate          DateTime  @default(now())

  // Price Positioning (40%)
  currentPrice          Decimal   @db.Decimal(10, 2)
  marketAvgPrice        Decimal?  @db.Decimal(10, 2)
  priceVsMarket         Decimal?  @db.Decimal(5, 2) // % above/below market
  discountPct           Decimal   @default(0) @db.Decimal(5, 2)
  valueForMoneyIndex    Decimal?  @db.Decimal(5, 2)
  priceCompetitiveness  Decimal?  @db.Decimal(5, 2)

  // Competitive Analysis (30%)
  competitorCount       Int       @default(0)
  lowestCompPrice       Decimal?  @db.Decimal(10, 2)
  highestCompPrice      Decimal?  @db.Decimal(10, 2)
  medianCompPrice       Decimal?  @db.Decimal(10, 2)
  pricePercentile       Decimal?  @db.Decimal(5, 2) // Where price ranks (0-100)
  bestPriceIndicator    Boolean   @default(false)
  priceStability        Decimal?  @db.Decimal(5, 2) // Low volatility = high score

  // Total Cost of Ownership (20%)
  shippingCost          Decimal   @default(0) @db.Decimal(10, 2)
  taxAmount             Decimal?  @db.Decimal(10, 2)
  hiddenFees            Decimal   @default(0) @db.Decimal(10, 2)
  warrantyValue         Decimal?  @db.Decimal(10, 2)
  totalCost             Decimal?  @db.Decimal(10, 2) // price + shipping + fees

  // Market Dynamics (10%)
  priceTrend            String?   // "rising", "falling", "stable"
  demandLevel           Decimal?  @db.Decimal(5, 2) // Sales velocity
  supplyAvailability    Int?      // # of similar listings
  seasonalFactor        Decimal?  @db.Decimal(5, 2)

  // Market comparison data
  ebayListings          Json?     // Array of comp listings
  priceHistory          Json?     // Historical prices

  createdAt             DateTime  @default(now())

  // Relations
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([snapshotDate])
  @@index([currentPrice])
  @@map("veritas_market_data")
}

/// Table 7: Sustainability Data (Product + Certification Hybrid)
/// Cardinality: 1 product → 1 sustainability record
/// Update Frequency: 30 days (certifications change rarely)
/// Data Sources: iFixit, Energy Star, lifecycle databases
model VeritasSustainability {
  id                    String    @id @default(cuid())
  productId             String    @unique

  // Environmental Impact (40%)
  carbonFootprintKg     Decimal?  @db.Decimal(10, 2) // kg CO2
  carbonReduction       Decimal   @default(70) @db.Decimal(5, 2) // vs. new
  eWastePrevention      Decimal   @default(70) @db.Decimal(5, 2)
  resourceConservation  Decimal   @default(70) @db.Decimal(5, 2)
  manufacturingImpact   Decimal?  @db.Decimal(5, 2)

  // Circular Economy (30%)
  reuseFactor           Decimal   @default(70) @db.Decimal(5, 2)
  recyclingPotential    Decimal   @default(70) @db.Decimal(5, 2)
  refurbQuality         Decimal   @default(70) @db.Decimal(5, 2)
  upcyclingPotential    Decimal?  @db.Decimal(5, 2)

  // Product Longevity (20%)
  expectedLifespanYears Int?
  repairabilityScore    Decimal?  @db.Decimal(4, 1) // 0-10 (iFixit)
  softwareSupportYears  Int?
  partsAvailable        Boolean   @default(false)
  repairDifficulty      String?   // "easy", "moderate", "difficult"

  // Certifications (10%)
  energyStarCertified   Boolean   @default(false)
  energyStarRating      String?   // "Most Efficient", "Certified"
  epeatRating           String?   // "Gold", "Silver", "Bronze"
  refurbCertification   String?   // "apple_certified", "manufacturer", "third_party"
  otherCertifications   String[]  @default([])

  // Data sources
  ifixitUrl             String?
  energyStarUrl         String?
  epeatUrl              String?
  dataSourceUrls        Json?

  lastCertCheck         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([energyStarCertified])
  @@index([repairabilityScore])
  @@map("veritas_sustainability")
}

/// Table 8: User Experience Data (Listing Level)
/// Cardinality: 1 product → 1 UX record
/// Update Frequency: 7 days (listing quality stable)
/// Data Sources: Content analysis, AI image analysis
model VeritasUserExperience {
  id                    String    @id @default(cuid())
  productId             String    @unique

  // Listing Quality (40%)
  pageQuality           Decimal   @default(70) @db.Decimal(5, 2)
  descriptionComplete   Decimal   @default(70) @db.Decimal(5, 2)
  transparencyScore     Decimal   @default(70) @db.Decimal(5, 2)
  descriptionWordCount  Int?
  hasKeySpecs           Boolean   @default(false)

  // Visual Presentation (30%)
  imageQuality          Decimal   @default(70) @db.Decimal(5, 2)
  imageCount            Int       @default(0)
  hasMultipleAngles     Boolean   @default(false)
  imageResolution       String?   // "high", "medium", "low"
  hasVideoContent       Boolean   @default(false)

  // Purchase Experience (20%)
  checkoutEase          Decimal   @default(70) @db.Decimal(5, 2)
  navigationQuality     Decimal   @default(70) @db.Decimal(5, 2)
  mobileOptimized       Boolean   @default(true)
  pageLoadSpeed         Decimal?  @db.Decimal(5, 2) // seconds

  // Customer Support (10%)
  supportAccessibility  Decimal   @default(70) @db.Decimal(5, 2)
  faqQuality            Decimal   @default(70) @db.Decimal(5, 2)
  chatAvailable         Boolean   @default(false)
  phoneSupport          Boolean   @default(false)

  // AI Analysis
  contentAnalysisScore  Decimal?  @db.Decimal(5, 2)
  imageAIScore          Decimal?  @db.Decimal(5, 2)

  lastUXCheck           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([pageQuality])
  @@map("veritas_user_experience")
}
