generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  firstName          String?
  lastName           String?
  passwordHash       String?
  emailVerified      DateTime?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  affiliateClicks    AffiliateClick[]
  buyer              Buyer?
  productComparisons ProductComparison[]
  seller             Seller?
  sessions           Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Buyer {
  id                    String                @id @default(cuid())
  userId                String                @unique
  firstName             String
  lastName              String
  email                 String                @unique
  phone                 String?
  dateOfBirth           DateTime?
  gender                Gender?
  address               String?
  city                  String?
  state                 String?
  zipCode               String?
  country               String?
  buyerType             BuyerType             @default(CASUAL)
  notificationFrequency NotificationFrequency @default(WEEKLY)
  receiveNewsletters    Boolean               @default(true)
  receiveSms            Boolean               @default(false)
  receiveDeals          Boolean               @default(true)
  totalOrders           Int                   @default(0)
  totalSpent            Float                 @default(0.0)
  averageOrderValue     Float                 @default(0.0)
  loyaltyPoints         Float                 @default(0.0)
  maxBudget             Float                 @default(1000.0)
  minDiscountThreshold  Float                 @default(10.0)
  favoriteItems         Int                   @default(0)
  isActive              Boolean               @default(true)
  emailVerified         Boolean               @default(false)
  phoneVerified         Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lastLoginAt           DateTime?
  lastOrderAt           DateTime?
  preferredCategories   String[]
  preferredBrands       String[]
  preferredSizes        String[]
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems             CartItem[]
  orders                Order[]
  reviews               Review[]
  swipeSessions         SwipeSession[]

  @@map("buyers")
}

model Seller {
  id                       String     @id @default(cuid())
  userId                   String     @unique
  businessName             String
  ownerName                String
  email                    String     @unique
  phone                    String
  address                  String
  city                     String?
  state                    String?
  zipCode                  String?
  sellerType               SellerType @default(INDIVIDUAL)
  businessLicense          String?
  paypalEmail              String?
  description              String?
  totalSales               Int        @default(0)
  totalRevenue             Decimal    @default(0.0) @db.Decimal(10, 2)
  rating                   Float      @default(0.0)
  commissionRate           Float      @default(0.1)
  isActive                 Boolean    @default(true)
  isVerified               Boolean    @default(false)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  lastLoginAt              DateTime?
  categories               String[]
  avgResponseTimeHours     Float      @default(12.0)
  avgShipmentDays          Float      @default(3.0)
  customerSatisfactionRate Float      @default(0.90)
  defectRate               Float      @default(0.02)
  lastResponseAt           DateTime?
  onTimeDeliveryRate       Float      @default(0.95)
  responseTimeHours        Float      @default(24.0)
  products                 Product[]
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@index([isVerified])
  @@index([responseTimeHours])
  @@index([onTimeDeliveryRate])
  @@map("sellers")
}

model Product {
  id                    String              @id @default(cuid())
  name                  String
  category              String
  brand                 String?
  price                 Float
  originalPrice         Float               @default(0.0)
  condition             String?
  description           String?
  imageUrl              String?
  storeId               String?
  size                  String?
  isAvailable           Boolean             @default(true)
  sellerId              String?

  // Veritas Score™ Relational Foreign Keys
  companyProfileId      String?             // Link to brand data (Apple, Sony, etc.)
  productSpecId         String?             // Link to model specs (iPhone 15 Pro Max)
  sellerProfileId       String?             // Link to seller trust data
  securityPolicyId      String?             // Link to platform security policies

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  cartAdditionCount     Int                 @default(0)
  certifications        String[]            @default([])
  clickCount            Int                 @default(0)
  estimatedDeliveryDays Int                 @default(5)
  hasFreeReturns        Boolean             @default(false)
  hasFreeShipping       Boolean             @default(false)
  hasWarranty           Boolean             @default(false)
  height                Float?
  isAuthentic           Boolean             @default(true)
  lastCartAddedAt       DateTime?
  lastPurchasedAt       DateTime?
  lastViewedAt          DateTime?
  length                Float?
  lowStockThreshold     Int                 @default(5)
  popularityScore       Float               @default(0.0)
  purchaseCount         Int                 @default(0)
  qualityScore          Float               @default(0.0)
  relevanceScore        Float               @default(0.0)
  returnPeriodDays      Int                 @default(30)
  searchKeywords        String[]            @default([])
  shippingCost          Float               @default(0.0)
  stockQuantity         Int                 @default(0)
  tags                  String[]            @default([])
  trendingScore         Float               @default(0.0)
  viewCount             Int                 @default(0)
  warrantyMonths        Int?
  weight                Float?
  width                 Float?
  wishlistCount         Int                 @default(0)
  aiScore               Decimal?            @map("ai_score") @db.Decimal(5, 2)
  aiScoreBreakdown      Json?               @map("ai_score_breakdown")
  aiConfidence          Decimal?            @map("ai_confidence") @db.Decimal(3, 2)
  lastScoredAt          DateTime?           @map("last_scored_at") @db.Timestamp(6)
  companyMetrics        Json?               @map("company_metrics")
  dynamicSpecs          Json?               @map("dynamic_specs")
  globalRank            Int?                @map("global_rank")
  categoryRank          Int?                @map("category_rank")
  priceTierRank         Int?                @map("price_tier_rank")
  price_tier            String?             @db.VarChar(20)
  leaderboardBadges     String[]            @default([]) @map("leaderboard_badges")
  embeddingUpdatedAt    DateTime?           @map("embedding_updated_at") @db.Timestamp(6)
  cartItems             CartItem[]
  orderItems            OrderItem[]
  aiSummary             ProductAISummary?
  analytics             ProductAnalytics[]
  comparisons           ProductComparison[]
  legacyEmbedding       ProductEmbedding?   @relation("LegacyEmbedding")
  views                 ProductView[]
  seller                Seller?             @relation(fields: [sellerId], references: [id])
  reviews               Review[]
  swipeActions          SwipeAction[]

  // Veritas Score™ Relational Architecture
  veritasScore          VeritasScore?
  veritasHistory        VeritasScoreHistory[]
  competitorAnalyses    VeritasCompetitorAnalysis[]

  // NEW: 8-Table Relational System
  companyProfile        VeritasCompanyProfile?  @relation(fields: [companyProfileId], references: [id])
  productSpec           VeritasProductSpec?     @relation(fields: [productSpecId], references: [id])
  sellerProfile         VeritasSellerProfile?   @relation(fields: [sellerProfileId], references: [id])
  securityPolicy        VeritasSecurityPolicy?  @relation(fields: [securityPolicyId], references: [id])
  productQuality        VeritasProductQuality?
  marketData            VeritasMarketData[]
  sustainability        VeritasSustainability?
  userExperience        VeritasUserExperience?

  @@index([isAvailable])
  @@index([category])
  @@index([brand])
  @@index([condition])
  @@index([size])
  @@index([price])
  @@index([createdAt])
  @@index([category, isAvailable])
  @@index([brand, isAvailable])
  @@index([price, isAvailable])
  @@index([category, brand, isAvailable])
  @@index([name])
  @@index([sellerId])
  @@index([popularityScore])
  @@index([trendingScore])
  @@index([qualityScore])
  @@index([stockQuantity])
  @@index([hasFreeShipping])
  @@index([lastViewedAt])
  @@index([viewCount])
  @@index([aiScore(sort: Desc)], map: "idx_products_ai_score")
  @@index([companyProfileId])
  @@index([productSpecId])
  @@index([sellerProfileId])
  @@index([securityPolicyId])
  @@map("products")
}

model ProductEmbedding {
  productId            String   @id
  nameEmbedding        String?
  descriptionEmbedding String?
  combinedEmbedding    String?
  needsUpdate          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  product              Product  @relation("LegacyEmbedding", fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_embeddings")
}

model Order {
  id                   String        @id @default(cuid())
  buyerId              String
  sessionId            String?
  subtotal             Float
  tax                  Float
  shipping             Float
  total                Float
  status               OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(PENDING)
  paymentMethod        String?
  paymentTransactionId String?
  trackingNumber       String?
  billingName          String?
  billingAddress       String?
  billingCity          String?
  billingState         String?
  billingZip           String?
  billingCountry       String?
  shippingName         String?
  shippingAddress      String?
  shippingCity         String?
  shippingState        String?
  shippingZip          String?
  shippingPhone        String?
  orderNotes           String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  shippedAt            DateTime?
  deliveredAt          DateTime?
  estimatedDelivery    DateTime?
  items                OrderItem[]
  buyer                Buyer         @relation(fields: [buyerId], references: [id])

  @@map("orders")
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  productId        String
  quantity         Int
  unitPrice        Float
  totalPrice       Float
  productName      String?
  productCategory  String?
  productBrand     String?
  productCondition String?
  productSize      String?
  productImageUrl  String?
  sellerId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model CartItem {
  id          String   @id @default(cuid())
  sessionId   String
  buyerId     String?
  productId   String
  quantity    Int      @default(1)
  priceAtTime Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  buyer       Buyer?   @relation(fields: [buyerId], references: [id])
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Review {
  id                 String        @id @default(cuid())
  buyerId            String
  productId          String
  title              String
  content            String?
  rating             Int
  conditionRating    Int?
  valueRating        Int?
  sellerRating       Int?
  shippingRating     Int?
  isVerifiedPurchase Boolean       @default(false)
  helpfulVotes       Int           @default(0)
  unhelpfulVotes     Int           @default(0)
  status             ReviewStatus  @default(PENDING)
  moderationNotes    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  photos             ReviewPhoto[]
  buyer              Buyer         @relation(fields: [buyerId], references: [id])
  product            Product       @relation(fields: [productId], references: [id])

  @@map("reviews")
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  photoUrl String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_photos")
}

model CategoryConfiguration {
  id             BigInt            @id @default(autoincrement())
  categoryName   String            @unique @db.VarChar(100)
  parentCategory String?           @db.VarChar(100)
  displayName    String            @db.VarChar(200)
  description    String?
  isActive       Boolean           @default(true)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  keywords       CategoryKeyword[]

  @@map("category_configuration")
}

model CategoryKeyword {
  id                    BigInt                @id @default(autoincrement())
  categoryId            BigInt
  keyword               String                @db.VarChar(100)
  synonym               String?               @db.VarChar(100)
  weight                Decimal               @default(1.0) @db.Decimal(3, 2)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  categoryConfiguration CategoryConfiguration @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([keyword])
  @@index([categoryId, keyword])
  @@map("category_keywords")
}

model SearchExclusionConfiguration {
  id               BigInt   @id @default(autoincrement())
  ruleName         String   @db.VarChar(100)
  searchContext    String   @db.VarChar(100)
  exclusionKeyword String   @db.VarChar(100)
  exclusionType    String   @default("STRICT") @db.VarChar(50)
  categoryId       BigInt?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([searchContext, exclusionKeyword])
  @@map("search_exclusion_configuration")
}

model SearchKeywordConfiguration {
  id          BigInt            @id @default(autoincrement())
  keywordType SearchKeywordType
  keyword     String            @db.VarChar(100)
  category    String?           @db.VarChar(100)
  synonyms    String[]
  weight      Decimal           @default(1.0) @db.Decimal(3, 2)
  isActive    Boolean           @default(true)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([keywordType, keyword])
  @@index([keywordType, isActive])
  @@map("search_keyword_configuration")
}

model BrandConfiguration {
  id             BigInt         @id @default(autoincrement())
  brandName      String         @unique @db.VarChar(100)
  normalizedName String         @db.VarChar(100)
  reputation     Int            @default(70)
  isPremium      Boolean        @default(false)
  warranty       String?        @db.VarChar(50)
  category       String?        @db.VarChar(100)
  isActive       Boolean        @default(true)
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  keywords       BrandKeyword[]

  @@index([normalizedName])
  @@index([isPremium])
  @@index([reputation])
  @@map("brand_configuration")
}

model BrandKeyword {
  id                 BigInt             @id @default(autoincrement())
  brandId            BigInt
  keyword            String             @db.VarChar(100)
  keywordType        BrandKeywordType
  weight             Decimal            @default(1.0) @db.Decimal(3, 2)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  brandConfiguration BrandConfiguration @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([keyword])
  @@index([brandId, keyword])
  @@index([keywordType])
  @@map("brand_keywords")
}

model CategoryMappingConfiguration {
  id              BigInt   @id @default(autoincrement())
  categoryName    String   @unique @db.VarChar(100)
  amazonCategory  String   @db.VarChar(100)
  subcategories   String[]
  avgShippingDays Int      @default(3)
  returnWindow    Int      @default(30)
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryName])
  @@map("category_mapping_configuration")
}

model AffiliateProduct {
  id                 String          @id @default(cuid())
  name               String          @db.VarChar(200)
  description        String?
  brand              String          @db.VarChar(100)
  category           String          @db.VarChar(100)
  subcategory        String?         @db.VarChar(50)
  sku                String          @unique @db.VarChar(100)
  price              Float
  originalPrice      Float?
  discountPercentage Float?
  affiliateSource    AffiliateSource
  affiliateId        String?         @db.VarChar(100)
  affiliateUrl       String          @db.VarChar(500)
  commissionRate     Float?
  commissionAmount   Float?
  imageUrl           String?         @db.VarChar(500)
  targetGender       TargetGender?
  season             Season?
  ageGroup           String?         @db.VarChar(50)
  inStock            Boolean         @default(true)
  stockQuantity      Int?
  seoTitle           String?         @db.VarChar(200)
  seoDescription     String?         @db.VarChar(500)
  rating             Float?
  reviewCount        Int             @default(0)
  isActive           Boolean         @default(true)
  isFeatured         Boolean         @default(false)
  colors             String[]
  sizes              String[]
  images             String[]
  keywords           String[]
  tags               String[]
  specifications     Json?
  trendingKeywords   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  lastSyncAt         DateTime        @default(now())
  dataExpiresAt      DateTime

  @@map("affiliate_products")
}

model ExternalProduct {
  id                String              @id @default(cuid())
  source            ExternalSource
  externalId        String
  title             String
  description       String?
  brand             String?
  category          String
  price             Float
  originalPrice     Float?
  currency          String              @default("USD")
  shippingCost      Float?
  productUrl        String
  affiliateUrl      String?
  imageUrl          String?
  condition         String?
  rating            Float?
  reviewCount       Int                 @default(0)
  availability      Boolean             @default(true)
  cachedAt          DateTime            @default(now())
  expiresAt         DateTime
  amazonComparisons ProductComparison[] @relation("AmazonProduct")
  ebayComparisons   ProductComparison[] @relation("EbayProduct")

  @@unique([source, externalId])
  @@index([source, externalId])
  @@index([brand, category])
  @@index([cachedAt])
  @@map("external_products")
}

model ProductComparison {
  id                String           @id @default(cuid())
  searchQuery       String
  userId            String?
  thriftaiProductId String?
  amazonProductId   String?
  ebayProductId     String?
  bestDealSource    String
  bestDealPrice     Float
  estimatedSavings  Float
  userClicked       Boolean          @default(false)
  clickedSource     String?
  createdAt         DateTime         @default(now())
  amazonProduct     ExternalProduct? @relation("AmazonProduct", fields: [amazonProductId], references: [id])
  ebayProduct       ExternalProduct? @relation("EbayProduct", fields: [ebayProductId], references: [id])
  thriftaiProduct   Product?         @relation(fields: [thriftaiProductId], references: [id])
  user              User?            @relation(fields: [userId], references: [id])

  @@index([searchQuery])
  @@index([userId])
  @@map("product_comparisons")
}

model AffiliateClick {
  id                 String         @id @default(cuid())
  userId             String?
  sessionId          String
  source             ExternalSource
  externalProductId  String
  productTitle       String
  affiliateUrl       String
  referralCode       String
  estimatedPrice     Float
  expectedCommission Float?
  clicked            Boolean        @default(false)
  clickedAt          DateTime?
  converted          Boolean        @default(false)
  convertedAt        DateTime?
  commissionEarned   Float?
  createdAt          DateTime       @default(now())
  user               User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([source])
  @@index([clicked, converted])
  @@map("affiliate_clicks")
}

model ProductAnalytics {
  id                   String   @id @default(cuid())
  productId            String
  date                 DateTime @db.Date
  views                Int      @default(0)
  uniqueViews          Int      @default(0)
  clicks               Int      @default(0)
  cartAdditions        Int      @default(0)
  purchases            Int      @default(0)
  wishlistAdds         Int      @default(0)
  clickThroughRate     Float    @default(0.0)
  conversionRate       Float    @default(0.0)
  bounceRate           Float    @default(0.0)
  cartAbandonRate      Float    @default(0.0)
  revenue              Float    @default(0.0)
  avgTimeOnPageSeconds Float    @default(0.0)
  avgScrollDepth       Float    @default(0.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@index([productId, date])
  @@index([views])
  @@index([purchases])
  @@map("product_analytics")
}

model ProductView {
  id                String   @id @default(cuid())
  productId         String
  userId            String?
  sessionId         String
  source            String
  searchQuery       String?
  referrer          String?
  position          Int?
  timeOnPageSeconds Int?
  scrollDepth       Float?
  didAddToCart      Boolean  @default(false)
  didPurchase       Boolean  @default(false)
  didBounce         Boolean  @default(false)
  deviceType        String?
  browser           String?
  country           String?
  city              String?
  createdAt         DateTime @default(now())
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([source])
  @@index([searchQuery])
  @@map("product_views")
}

model SearchQuery {
  id               String   @id @default(cuid())
  query            String
  userId           String?
  sessionId        String
  userCategory     String?
  previousQuery    String?
  resultCount      Int
  clickedProductId String?
  clickPosition    Int?
  responseTimeMs   Int
  aiConfidence     Float?
  didClickResult   Boolean  @default(false)
  didPurchase      Boolean  @default(false)
  refinedQuery     String?
  filtersApplied   Json?
  createdAt        DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([resultCount])
  @@map("search_queries")
}

model UserSession {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  userId          String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  pageViews       Int       @default(0)
  productViews    Int       @default(0)
  searchQueries   Int       @default(0)
  cartAdditions   Int       @default(0)
  purchases       Int       @default(0)
  convertedToSale Boolean   @default(false)
  totalSpent      Float     @default(0.0)
  deviceType      String?
  browser         String?
  country         String?
  referrer        String?

  @@index([sessionId])
  @@index([userId])
  @@index([startedAt])
  @@index([convertedToSale])
  @@map("user_sessions")
}

model ProductAISummary {
  id           String   @id @default(cuid())
  productId    String   @unique
  summary      Json
  reviewCount  Int      @default(0)
  avgRating    Float?
  cacheVersion String   @default("v1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([updatedAt])
  @@map("product_ai_summaries")
}

model SwipeSession {
  id               String        @id @default(cuid())
  userId           String?
  buyerId          String?
  filters          Json
  totalSwipes      Int           @default(0)
  totalLikes       Int           @default(0)
  totalSkips       Int           @default(0)
  totalViewDetails Int           @default(0)
  itemsAddedToCart Int           @default(0)
  converted        Boolean       @default(false)
  totalSpent       Float         @default(0.0)
  startedAt        DateTime      @default(now())
  endedAt          DateTime?
  durationSeconds  Int?
  deviceType       String?
  userAgent        String?
  actions          SwipeAction[]
  buyer            Buyer?        @relation(fields: [buyerId], references: [id])

  @@index([userId])
  @@index([buyerId])
  @@index([startedAt])
  @@index([converted])
  @@map("swipe_sessions")
}

model SwipeAction {
  id             String          @id @default(cuid())
  sessionId      String
  productId      String
  action         SwipeActionType
  cardPosition   Int?
  timeSpent      Int?
  swipeDirection String?
  swipeVelocity  Float?
  viewedDetails  Boolean         @default(false)
  scrollDepth    Float?
  addedToCart    Boolean         @default(false)
  purchased      Boolean         @default(false)
  timestamp      DateTime        @default(now())
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
