/// Veritas Score™ - 8 Quality Categories
///
/// Universal across ALL product conditions (new, refurbished, used, rental)
/// Each category adapted based on product condition for accurate assessment
///
/// PRODUCT_QUALITY (25%): Physical condition, authenticity, functionality
/// - NEW: Packaging, warranty, defect rate
/// - REFURB: Certification level, OEM parts, testing
/// - USED: Actual condition, wear, remaining lifespan
///
/// SELLER_TRUST (20%): Reputation, reliability, customer service
/// - Authorized dealers: Higher baseline score
/// - Certified refurbishers: Certification bonus
/// - Individual sellers: Transaction history-based
///
/// MARKET_VALUE (15%): Price fairness, value for money
/// - NEW: % below MSRP
/// - REFURB: vs. expected depreciation
/// - USED: vs. similar condition items
///
/// SUSTAINABILITY (12%): Environmental impact, circular economy
/// - NEW: Lower score (encourages refurb/used)
/// - REFURB: High score (professional restoration)
/// - USED: Highest score (maximum reuse)
///
/// SECURITY_SAFETY (5%): Payment security, buyer protection
///
/// USER_EXPERIENCE (5%): Listing quality, customer service
///
/// PRODUCT_SPECIFICATION (13%): Category-specific tech specs
/// - Adapts to product category (electronics, fashion, furniture, etc.)
///
/// COMPANY_PERFORMANCE (5%): Brand reputation, news sentiment, market data
enum VeritasCategoryType {
  PRODUCT_QUALITY
  SELLER_TRUST
  MARKET_VALUE
  SUSTAINABILITY
  SECURITY_SAFETY
  USER_EXPERIENCE
  PRODUCT_SPECIFICATION
  COMPANY_PERFORMANCE
}

enum attribute_value_type {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum experiment_status {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}
