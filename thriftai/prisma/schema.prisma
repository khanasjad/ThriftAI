// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// CORE ENTITIES
// ========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String?
  lastName      String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // Authentication
  accounts Account[]
  sessions Session[]

  // User type
  buyer  Buyer?
  seller Seller?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ========================================
// BUSINESS ENTITIES
// ========================================

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum BuyerType {
  CASUAL
  FREQUENT
  VIP
  BULK_BUYER
}

enum NotificationFrequency {
  NEVER
  DAILY
  WEEKLY
  MONTHLY
}

model Buyer {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  firstName              String
  lastName               String
  email                  String                 @unique
  phone                  String?
  dateOfBirth            DateTime?
  gender                 Gender?

  // Address
  address                String?
  city                   String?
  state                  String?
  zipCode                String?
  country                String?

  // Preferences
  buyerType              BuyerType              @default(CASUAL)
  notificationFrequency  NotificationFrequency  @default(WEEKLY)
  receiveNewsletters     Boolean                @default(true)
  receiveSms             Boolean                @default(false)
  receiveDeals           Boolean                @default(true)

  // Metrics
  totalOrders            Int                    @default(0)
  totalSpent             Float                  @default(0.0)
  averageOrderValue      Float                  @default(0.0)
  loyaltyPoints          Float                  @default(0.0)
  maxBudget              Float                  @default(1000.0)
  minDiscountThreshold   Float                  @default(10.0)
  favoriteItems          Int                    @default(0)

  // Status
  isActive               Boolean                @default(true)
  emailVerified          Boolean                @default(false)
  phoneVerified          Boolean                @default(false)

  // Timestamps
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  lastLoginAt            DateTime?
  lastOrderAt            DateTime?

  // Relations
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders                 Order[]
  cartItems              CartItem[]
  reviews                Review[]
  preferredCategories    String[]
  preferredBrands        String[]
  preferredSizes         String[]

  @@map("buyers")
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
  ENTERPRISE
}

model Seller {
  id                     String      @id @default(cuid())
  userId                 String      @unique
  businessName           String
  ownerName              String
  email                  String      @unique
  phone                  String
  address                String
  city                   String?
  state                  String?
  zipCode                String?

  // Business Details
  sellerType             SellerType  @default(INDIVIDUAL)
  businessLicense        String?
  paypalEmail            String?
  description            String?

  // Metrics
  totalSales             Int         @default(0)
  totalRevenue           Decimal     @default(0.0) @db.Decimal(10,2)
  rating                 Float       @default(0.0)
  commissionRate         Float       @default(0.1)

  // Status
  isActive               Boolean     @default(true)
  isVerified             Boolean     @default(false)

  // Timestamps
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  lastLoginAt            DateTime?

  // Relations
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products               Product[]
  categories             String[]

  @@map("sellers")
}

model Product {
  id               String    @id @default(cuid())
  name             String
  category         String
  brand            String?
  price            Float
  originalPrice    Float     @default(0.0)
  condition        String?
  description      String?   @db.Text
  imageUrl         String?
  storeId          String?
  size             String?
  isAvailable      Boolean   @default(true)

  // Relations
  sellerId         String?
  seller           Seller?   @relation(fields: [sellerId], references: [id])
  orderItems       OrderItem[]
  cartItems        CartItem[]
  reviews          Review[]
  embedding        ProductEmbedding?

  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("products")
}

model ProductEmbedding {
  productId             String   @id
  nameEmbedding         String?  @db.Text
  descriptionEmbedding  String?  @db.Text
  combinedEmbedding     String?  @db.Text
  needsUpdate           Boolean  @default(false)

  // Relations
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("product_embeddings")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id                    String        @id @default(cuid())
  buyerId               String
  sessionId             String?
  subtotal              Float
  tax                   Float
  shipping              Float
  total                 Float

  // Status
  status                OrderStatus   @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  paymentMethod         String?
  paymentTransactionId  String?
  trackingNumber        String?

  // Billing Address
  billingName           String?
  billingAddress        String?
  billingCity           String?
  billingState          String?
  billingZip            String?
  billingCountry        String?

  // Shipping Address
  shippingName          String?
  shippingAddress       String?
  shippingCity          String?
  shippingState         String?
  shippingZip           String?
  shippingPhone         String?

  // Notes
  orderNotes            String?

  // Timestamps
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  shippedAt             DateTime?
  deliveredAt           DateTime?
  estimatedDelivery     DateTime?

  // Relations
  buyer                 Buyer         @relation(fields: [buyerId], references: [id])
  items                 OrderItem[]

  @@map("orders")
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  productId        String
  quantity         Int
  unitPrice        Float
  totalPrice       Float

  // Product snapshot
  productName      String?
  productCategory  String?
  productBrand     String?
  productCondition String?
  productSize      String?
  productImageUrl  String?
  sellerId         String?

  // Relations
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id])

  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("order_items")
}

model CartItem {
  id            String   @id @default(cuid())
  sessionId     String
  buyerId       String?
  productId     String
  quantity      Int      @default(1)
  priceAtTime   Float?

  // Relations
  buyer         Buyer?   @relation(fields: [buyerId], references: [id])
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("cart_items")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

model Review {
  id                     String       @id @default(cuid())
  buyerId                String
  productId              String
  title                  String
  content                String?      @db.Text
  rating                 Int          // 1-5

  // Detailed ratings
  conditionRating        Int?         // 1-5
  valueRating            Int?         // 1-5
  sellerRating           Int?         // 1-5
  shippingRating         Int?         // 1-5

  // Metadata
  isVerifiedPurchase     Boolean      @default(false)
  helpfulVotes           Int          @default(0)
  unhelpfulVotes         Int          @default(0)
  status                 ReviewStatus @default(PENDING)
  moderationNotes        String?

  // Relations
  buyer                  Buyer        @relation(fields: [buyerId], references: [id])
  product                Product      @relation(fields: [productId], references: [id])
  photos                 ReviewPhoto[]

  // Timestamps
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@map("reviews")
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  photoUrl String

  // Relations
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_photos")
}

// ========================================
// CONFIGURATION ENTITIES
// ========================================

model CategoryConfiguration {
  id              BigInt            @id @default(autoincrement())
  categoryName    String            @unique @db.VarChar(100)
  parentCategory  String?           @db.VarChar(100)
  displayName     String            @db.VarChar(200)
  description     String?           @db.Text
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)

  // Relations
  keywords        CategoryKeyword[]

  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("category_configuration")
}

model CategoryKeyword {
  id                      BigInt                @id @default(autoincrement())
  categoryId              BigInt
  keyword                 String                @db.VarChar(100)
  synonym                 String?               @db.VarChar(100)
  weight                  Decimal               @default(1.0) @db.Decimal(3,2)
  isActive                Boolean               @default(true)

  // Relations
  categoryConfiguration   CategoryConfiguration @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt               DateTime              @default(now())

  @@index([keyword])
  @@index([categoryId, keyword])
  @@map("category_keywords")
}

model SearchExclusionConfiguration {
  id              BigInt   @id @default(autoincrement())
  ruleName        String   @db.VarChar(100)
  searchContext   String   @db.VarChar(100)
  exclusionKeyword String  @db.VarChar(100)
  exclusionType   String   @default("STRICT") @db.VarChar(50)
  categoryId      BigInt?
  isActive        Boolean  @default(true)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([searchContext, exclusionKeyword])
  @@map("search_exclusion_configuration")
}

// ========================================
// AFFILIATE PRODUCTS
// ========================================

enum AffiliateSource {
  AMAZON
  EBAY
  ZALANDO
  ASOS
  H_AND_M
  ZARA
  UNIQLO
  NORDSTROM
  MACY
  TARGET
  WALMART
  SHOPIFY
  COMMISSION_JUNCTION
  SHAREASALE
  IMPACT
  RAKUTEN
  OTHER
}

enum Season {
  SPRING
  SUMMER
  FALL
  WINTER
  ALL_SEASON
}

enum TargetGender {
  MALE
  FEMALE
  UNISEX
  KIDS_BOYS
  KIDS_GIRLS
  KIDS_UNISEX
}

model AffiliateProduct {
  id                   String          @id @default(cuid())
  name                 String          @db.VarChar(200)
  description          String?         @db.Text
  brand                String          @db.VarChar(100)
  category             String          @db.VarChar(100)
  subcategory          String?         @db.VarChar(50)
  sku                  String          @unique @db.VarChar(100)
  price                Float
  originalPrice        Float?
  discountPercentage   Float?

  // Affiliate Info
  affiliateSource      AffiliateSource
  affiliateId          String?         @db.VarChar(100)
  affiliateUrl         String          @db.VarChar(500)
  commissionRate       Float?
  commissionAmount     Float?

  // Product Details
  imageUrl             String?         @db.VarChar(500)
  targetGender         TargetGender?
  season               Season?
  ageGroup             String?         @db.VarChar(50)

  // Inventory
  inStock              Boolean         @default(true)
  stockQuantity        Int?

  // SEO
  seoTitle             String?         @db.VarChar(200)
  seoDescription       String?         @db.VarChar(500)

  // Metrics
  rating               Float?
  reviewCount          Int             @default(0)
  isActive             Boolean         @default(true)
  isFeatured           Boolean         @default(false)

  // Collections
  colors               String[]
  sizes                String[]
  images               String[]
  keywords             String[]
  tags                 String[]
  specifications       Json?
  trendingKeywords     String?         @db.Text

  // Timestamps
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lastSyncAt           DateTime        @default(now())
  dataExpiresAt        DateTime

  @@map("affiliate_products")
}