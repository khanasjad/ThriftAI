// Veritas database schema.
// Source of truth for what we build: docs/rpi/00-PRODUCT-PLAN.md · design: docs/rpi/02-PLAN-BACKEND.md §5
//
// Data rules:
// - Every ingested record carries `source` (+ `licence` when external). Dev fixture rows use source = "dev-fixture".
// - Agents never write scores. Scores are written by deterministic code (src/lib/veritas/scoring).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Accounts and tenants
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String?
  lastName      String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(SHOPPER)
  tenantId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  accounts       Account[]
  sessions       Session[]
  shopperProfile ShopperProfile?

  @@index([tenantId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// A B2B customer (a brand, marketplace or platform). Brand-provided data stays private to its tenant.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String   @unique
  /// pilot | starter | growth | pro | platform (product plan pricing)
  plan      String   @default("pilot")
  isActive  Boolean  @default(true)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  brands   Brand[]
  products ClothingProduct[]
  apiKeys  ApiKey[]

  @@map("tenants")
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  /// SHA-256 of the key; the raw key is shown once at creation
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

// =============================================================================
// Catalog
// =============================================================================

model Brand {
  id             String   @id @default(cuid())
  tenantId       String?
  name           String   @unique
  slug           String   @unique
  description    String?
  website        String?
  foundedYear    Int?
  /// Published certifications claimed by the brand (OEKO-TEX, GOTS, B Corp…)
  certifications String[] @default([])
  /// Has a public supplier list / audits
  publishesSuppliers Boolean @default(false)
  hasRepairProgram   Boolean @default(false)
  hasTakeBack        Boolean @default(false)
  /// 0–100, computed by the Trend & Brand agent from evidence (not fame). Null until rated.
  reputationScore Int?
  logoUrl         String?
  source          String
  licence         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant?           @relation(fields: [tenantId], references: [id])
  products     ClothingProduct[]
  trendSignals TrendSignal[]
  findings     AgentFinding[]

  @@index([tenantId])
  @@map("brands")
}

model Seller {
  id        String   @id @default(cuid())
  /// Set for a platform's own vendors (marketplace sellers); null for shared dev/public sellers
  tenantId   String?
  externalId String?
  name      String
  slug      String   @unique
  website   String?
  source    String
  licence   String?
  createdAt DateTime @default(now())

  prices PriceSnapshot[]

  @@unique([tenantId, externalId])
  @@map("sellers")
}

model ClothingProduct {
  id          String           @id @default(cuid())
  tenantId    String?
  brandId     String
  name        String
  slug        String           @unique
  sku         String           @unique
  category    ClothingCategory
  /// tee | jeans | … (start with tees and jeans per the product plan)
  subcategory String?
  gender      ClothingGender
  description String?

  // Pricing (brand-direct list; per-seller history lives in PriceSnapshot)
  currentPrice  Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  currency      String   @default("USD")

  // Spec (inputs for quality/comfort/new-launch scoring)
  sizes            String[]
  colors           String[]
  /// {"cotton": 95, "elastane": 5}
  materials        Json
  fabricWeightGsm  Int?
  elastanePct      Int?
  fitType          String? // slim | regular | relaxed | oversized | straight | wide
  silhouette       String? // boxy-tee, crew-tee, wide-leg, skinny, straight…
  constructionType String?
  careInstructions String?
  hasPetite        Boolean  @default(false)
  hasTall          Boolean  @default(false)
  hasPlus          Boolean  @default(false)
  recycledContent  Int?
  certifications   String[] @default([])
  /// Units sold over the same window as the return events (from the brand or platform). Enables return *rates*.
  unitsSold        Int?
  /// Median resale price as % of retail, from a licensed resale-data partner. Null when unknown.
  resaleRetainedPct Int?

  launchDate      DateTime?
  trendTag        TrendTag?
  isAvailable     Boolean   @default(true)
  images          String[]  @default([])
  primaryImageUrl String?

  /// Private to its tenant (imported platform data). Public pages never show private products.
  isPrivate  Boolean @default(false)
  /// The platform's own id for this product (ingest upserts by tenant + externalId)
  externalId String?
  /// Product page on the platform, for ads and deep links
  url        String?

  source    String
  licence   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand          Brand            @relation(fields: [brandId], references: [id])
  tenant         Tenant?          @relation(fields: [tenantId], references: [id])
  reviews        ClothingReview[]
  returns        ReturnEvent[]
  evidenceTags   EvidenceTag[]
  priceSnapshots PriceSnapshot[]
  factorScores   FactorScore[]
  productScore   ProductScore?
  findings       AgentFinding[]
  agentRuns      AgentRun[]
  adCopy         AdCopy?
  visual         ProductVisual?

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([brandId])
  @@index([category, subcategory])
  @@index([currentPrice])
  @@map("clothing_products")
}

/// Reviewer names are not stored (PII rule). Review text is untrusted input for agents.
model ClothingReview {
  id        String @id @default(cuid())
  productId String

  title   String?
  content String
  rating  Int // 1-5
  language String @default("en")

  fitRating     Int?
  qualityRating Int?
  comfortRating Int?
  styleRating   Int?
  valueRating   Int?

  sizePurchased String?
  fitsAs        String? // runs_small | true_to_size | runs_large
  heightCm      Int?
  weightKg      Int?
  bodyType      String?

  wearDuration    String?
  pillingObserved Boolean?
  colorFading     Boolean?
  shrinkage       Boolean?

  isVerifiedPurchase Boolean  @default(false)
  helpfulVotes       Int      @default(0)
  reviewDate         DateTime @default(now())

  /// The platform's own review id (ingest upserts by product + externalId)
  externalId String?

  /// Set by guardrails when the text looks like a prompt-injection attempt
  injectionFlag Boolean   @default(false)
  processedAt   DateTime?

  source    String
  licence   String?
  createdAt DateTime @default(now())

  product      ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  evidenceTags EvidenceTag[]

  @@unique([productId, externalId])
  @@index([productId])
  @@index([reviewDate])
  @@map("clothing_reviews")
}

model ReturnEvent {
  id             String         @id @default(cuid())
  productId      String
  returnReason   ReturnReason
  returnCategory ReturnCategory
  detailedReason String?
  sizePurchased  String?
  purchasePrice  Decimal?       @db.Decimal(10, 2)
  purchaseDate   DateTime?
  returnDate     DateTime       @default(now())
  exchangedForSize String?
  /// The platform's own return id (idempotent ingest)
  externalId     String?
  processedAt    DateTime?
  source         String
  licence        String?
  createdAt      DateTime       @default(now())

  product      ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  evidenceTags EvidenceTag[]

  @@unique([productId, externalId])
  @@index([productId])
  @@index([returnCategory])
  @@map("return_events")
}

model PriceSnapshot {
  id        String   @id @default(cuid())
  productId String
  sellerId  String?
  price     Decimal  @db.Decimal(10, 2)
  /// The "was" price the seller shows; used for fake-discount detection
  listPrice Decimal? @db.Decimal(10, 2)
  isPromo   Boolean  @default(false)
  currency  String   @default("USD")
  observedAt DateTime @default(now())
  source    String
  licence   String?

  product ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller  Seller?         @relation(fields: [sellerId], references: [id])

  @@unique([productId, sellerId, observedAt])
  @@index([productId, observedAt])
  @@index([sellerId])
  @@map("price_snapshots")
}

model TrendSignal {
  id            String     @id @default(cuid())
  brandId       String?
  /// silhouette / colour / material key, e.g. "wide-leg", "boxy-tee", "skinny"
  trendName     String
  trendCategory String // silhouette | color | material | style
  trendScore    Int // 0-100
  trendPhase    TrendPhase
  weekOf        DateTime
  region        String?
  source        String
  licence       String?
  createdAt     DateTime   @default(now())

  brand Brand? @relation(fields: [brandId], references: [id])

  @@index([trendName, weekOf])
  @@map("trend_signals")
}

// =============================================================================
// Evidence, findings and scores
// =============================================================================

model EvidenceTag {
  id         String         @id @default(cuid())
  productId  String
  sourceType EvidenceSource
  reviewId   String?
  returnId   String?
  runId      String?

  factor     String // e.g. "fit.true_to_size"
  pillar     FactorPillar
  signal     String
  sentiment  Decimal        @db.Decimal(3, 2) // -1.00 … +1.00
  confidence Decimal        @db.Decimal(3, 2) // 0.00 … 1.00
  quote      String?
  /// Quote was found in the source text (guardrail). Ungrounded evidence is never stored as grounded.
  grounded      Boolean @default(true)
  injectionFlag Boolean @default(false)
  metadata      Json?
  createdAt     DateTime @default(now())

  product ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  review  ClothingReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  return  ReturnEvent?    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  run     AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([productId, factor])
  @@index([runId])
  @@map("evidence_tags")
}

/// Non-review findings from agents: price fairness, fake discount, brand roll-up, trend relevance, early score inputs.
model AgentFinding {
  id         String   @id @default(cuid())
  productId  String?
  brandId    String?
  runId      String?
  agent      String // price_value | trend_brand | …
  kind       String // price_fairness | fake_discount | often_cheaper | brand_rollup | trend_relevance | early_score
  factor     String?
  signal     String?
  sentiment  Decimal? @db.Decimal(3, 2)
  confidence Decimal? @db.Decimal(3, 2)
  summary    String?
  payload    Json
  createdAt  DateTime @default(now())

  product ClothingProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand   Brand?           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  run     AgentRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([productId, kind])
  @@index([brandId, kind])
  @@map("agent_findings")
}

model FactorScore {
  id            String       @id @default(cuid())
  productId     String
  factor        String
  pillar        FactorPillar
  /// Score after shrinkage toward the category mean (0-100)
  value         Decimal      @db.Decimal(5, 2)
  /// Score from evidence alone, before shrinkage
  rawValue      Decimal?     @db.Decimal(5, 2)
  weight        Int
  evidenceCount Int          @default(0)
  confidence    Confidence
  version       String       @default("v2")
  computedAt    DateTime     @default(now())

  product ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, factor, version])
  @@index([factor])
  @@map("factor_scores")
}

model ProductScore {
  id        String @id @default(cuid())
  productId String @unique

  /// 0-100 without sustainability (default view)
  overall                   Int
  /// 0-100 with sustainability switched on (pillars rescaled)
  overallWithSustainability Int?
  grade                     String

  fit            Int?
  quality        Int?
  styleValue     Int?
  comfort        Int?
  sustainability Int?

  confidence      Confidence
  confidenceLabel ConfidenceLabel
  evidenceCount   Int             @default(0)
  reviewCount     Int             @default(0)
  factorsIncluded String[]        @default([])
  factorsMissing  String[]        @default([])
  /// New-launch early score (before blending), when applicable
  earlyScore      Int?

  // Shopper-facing text: written by the Writer agent, checked by the Verifier
  summary    String?
  sizeAdvice String?
  downside   String?
  verified   Boolean @default(false)

  scoreVersion  String    @default("v2")
  inputsHash    String?
  ratedByRunId  String?
  calculatedAt  DateTime  @default(now())
  nextUpdateDue DateTime?

  product ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([overall])
  @@index([confidenceLabel])
  @@map("product_scores")
}

/// Prior for shrinkage: mean factor score per category (+subcategory) and how strongly to pull toward it.
model CategoryBaseline {
  id            String           @id @default(cuid())
  category      ClothingCategory
  subcategory   String           @default("")
  factor        String
  mean          Decimal          @db.Decimal(5, 2)
  priorStrength Int              @default(8)
  updatedAt     DateTime         @updatedAt

  @@unique([category, subcategory, factor])
  @@map("category_baselines")
}

// =============================================================================
// Shoppers and search
// =============================================================================

/// Optional, editable, deletable in one click (product plan: Personal Match privacy).
model ShopperProfile {
  id        String  @id @default(cuid())
  userId    String? @unique
  sessionId String? @unique

  heightCm        Int?
  weightKg        Int?
  bodyType        String?
  preferredFit    String?
  /// {"tops": "M", "bottoms": "32"}
  sizePreferences Json?
  climate         String? // hot | mild | cold | varies
  budgetMax       Int?
  occasions       String[] @default([])
  stylePreferences String[] @default([])
  /// Pillar weight overrides, e.g. {"COMFORT": 1.5, "QUALITY": 1.2}
  priorities      Json?
  brandAllow      String[] @default([])
  brandDeny       String[] @default([])
  sustainabilityOn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions SearchSession[]

  @@map("shopper_profiles")
}

model SearchSession {
  id        String   @id @default(cuid())
  profileId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile ShopperProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  turns   SearchTurn[]

  @@map("search_sessions")
}

model SearchTurn {
  id        String   @id @default(cuid())
  sessionId String
  idx       Int
  role      TurnRole
  content   String
  /// picks, clarifying question + chips, filters used
  payload   Json?
  runId     String?
  createdAt DateTime @default(now())

  session SearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idx])
  @@map("search_turns")
}

model Feedback {
  id         String         @id @default(cuid())
  targetType FeedbackTarget
  targetId   String
  /// +1 thumbs up, -1 thumbs down
  rating     Int
  reason     String?
  userId     String?
  sessionId  String?
  createdAt  DateTime       @default(now())

  @@index([targetType, targetId])
  @@map("feedback")
}

// =============================================================================
// Agent traces, spend and evals
// =============================================================================

model AgentRun {
  id          String         @id @default(cuid())
  graph       String? // rate-product | answer-search | eval | smoke
  agent       String
  status      AgentRunStatus @default(RUNNING)
  env         String
  model       String
  productId   String?
  parentRunId String?
  inputsHash  String?

  iterations       Int     @default(0)
  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  cacheReadTokens  Int     @default(0)
  cacheWriteTokens Int     @default(0)
  costUsd          Decimal @default(0) @db.Decimal(10, 6)

  finishPayload Json?
  error         String?
  traceId       String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  product  ClothingProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  parent   AgentRun?        @relation("RunTree", fields: [parentRunId], references: [id], onDelete: SetNull)
  children AgentRun[]       @relation("RunTree")
  steps    AgentStep[]
  evidence EvidenceTag[]
  findings AgentFinding[]

  @@index([agent, startedAt])
  @@index([productId])
  @@index([env, startedAt])
  @@map("agent_runs")
}

model AgentStep {
  id              String   @id @default(cuid())
  runId           String
  idx             Int
  kind            StepKind
  name            String
  input           Json?
  output          Json?
  isError         Boolean  @default(false)
  stopReason      String?
  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  costUsd         Decimal? @db.Decimal(10, 6)
  durationMs      Int?
  createdAt       DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, idx])
  @@map("agent_steps")
}

model EvalCase {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      String // evidence | writer | search
  productId String?
  input     Json?
  expected  Json
  createdAt DateTime @default(now())

  results EvalResult[]

  @@map("eval_cases")
}

model EvalRun {
  id         String    @id @default(cuid())
  model      String
  judgeModel String
  summary    Json?
  costUsd    Decimal   @default(0) @db.Decimal(10, 6)
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  results EvalResult[]

  @@map("eval_runs")
}

model EvalResult {
  id         String   @id @default(cuid())
  evalRunId  String
  evalCaseId String
  scores     Json
  passed     Boolean
  notes      String?
  runId      String?
  createdAt  DateTime @default(now())

  evalRun  EvalRun  @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  evalCase EvalCase @relation(fields: [evalCaseId], references: [id], onDelete: Cascade)

  @@unique([evalRunId, evalCaseId])
  @@map("eval_results")
}

// =============================================================================
// Pilot program
// =============================================================================

model PilotApplication {
  id           String   @id @default(cuid())
  companyName  String
  website      String?
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  productCount String?
  reviewCount  String?
  /// pending | approved | rejected | contacted | converted
  status       String   @default("pending")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("pilot_applications")
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  SHOPPER
  BRAND
  ADMIN
}

enum ClothingCategory {
  TOPS
  BOTTOMS
  DRESSES
  OUTERWEAR
  ACTIVEWEAR
  UNDERWEAR
  SHOES
  ACCESSORIES
}

enum ClothingGender {
  WOMENS
  MENS
  UNISEX
  KIDS_BOYS
  KIDS_GIRLS
}

enum ReturnReason {
  TOO_SMALL
  TOO_LARGE
  POOR_FIT
  POOR_QUALITY
  NOT_AS_DESCRIBED
  COLOR_MISMATCH
  STYLE_DISLIKE
  DAMAGE_DEFECT
  WRONG_ITEM
  CHANGED_MIND
  OTHER
}

enum ReturnCategory {
  FIT
  QUALITY
  STYLE
  OTHER
}

enum EvidenceSource {
  REVIEW
  RETURN
  SPEC
  PRICE
  TREND
  BRAND
  MANUAL
}

enum FactorPillar {
  FIT
  QUALITY
  STYLE_VALUE
  COMFORT
  SUSTAINABILITY
}

enum TrendPhase {
  EMERGING
  PEAK
  DECLINING
  CLASSIC
}

enum TrendTag {
  TRENDING
  CLASSIC
  FADING
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum ConfidenceLabel {
  HIGH
  MEDIUM
  LOW
  NEW_LAUNCH
}

enum AgentRunStatus {
  RUNNING
  OK
  SKIPPED
  BUDGET
  MAX_ITERATIONS
  REFUSAL
  TRUNCATED
  NO_FINISH
  TOOL_ERRORS
  TIMEOUT
  ERROR
}

enum StepKind {
  LLM
  TOOL
  GUARDRAIL
}

enum TurnRole {
  USER
  ASSISTANT
}

enum FeedbackTarget {
  PRODUCT_SCORE
  SEARCH_TURN
}

/// One upload or push to the ingest API, with its validation report (B10).
model IngestRun {
  id        String   @id @default(cuid())
  tenantId  String
  /// catalog | reviews | returns
  kind      String
  source    String
  licence   String?
  dryRun    Boolean  @default(false)
  rows      Int
  accepted  Int
  rejected  Int
  /// Created / updated / unchanged counts and the first rejected rows with reasons
  report    Json
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("ingest_runs")
}

/// Verified ad copy for one product (B11). Written by the ad-copy agent from evidence, checked by code and the Verifier.
model AdCopy {
  id          String   @id @default(cuid())
  productId   String   @unique
  headline    String
  body        String
  /// Writer items each line cites (shown as the ad's sources)
  sources     Json
  /// Same writer inputs + versions → same copy (no repeat cost)
  inputsHash  String
  costUsd     Decimal  @db.Decimal(10, 6)
  runIds      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("ad_copies")
}

/// What the product's photo shows, read by the vision agent (B12). Descriptive attributes only, never a score.
model ProductVisual {
  id         String   @id @default(cuid())
  productId  String   @unique
  imageUrl   String
  /// Image + agent version; same hash → not re-read
  imageHash  String
  /// { colors[{name,family}], pattern, pattern_detail, neckline, sleeve, shape, style_tags[], description, confidence }
  attributes Json
  runId      String?
  costUsd    Decimal  @db.Decimal(10, 6)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_visuals")
}

/// Sales outreach (B13). Company-level only: no personal contact data is stored here.
model OutreachTarget {
  id              String    @id @default(cuid())
  name            String
  /// brand | marketplace | retailer
  kind            String
  segment         String?
  website         String?
  /// target | contacted | replied | pilot | won | lost
  status          String    @default("target")
  scorecardSentAt DateTime?
  nextStep        String?
  notes           String?
  owner           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@map("outreach_targets")
}

/// Shared fixed-window rate-limit counters (production; works across server instances). Old windows are pruned nightly.
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}
