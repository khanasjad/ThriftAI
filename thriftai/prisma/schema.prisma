/// Veritas Score™ - Universal Product Quality Assessment System
///
/// The IMDB of Products - Works for ALL product conditions:
/// - NEW products (factory sealed, open-box)
/// - REFURBISHED products (certified, third-party)
/// - USED products (like new, excellent, good, fair)
/// - RENTAL products (equipment, tools)
/// - SUBSCRIPTION devices (upgrade programs)
///
/// Provides a single, objective quality score (0-100) based on:
/// - 8 quality categories (Product Quality, Seller Trust, Market Value, etc.)
/// - 121 verified parameters (26 currently implemented)
/// - Multi-source data validation
/// - Transparent, algorithm-driven methodology
///
/// Example Scores:
/// - New iPhone (sealed): 82/100 - Full price, full warranty
/// - Certified Refurb iPhone: 89/100 - Best value + quality combo
/// - Used iPhone (excellent): 85/100 - Great deal, some wear
model VeritasScore {
  id                    String                       @id @default(cuid())
  productId             String                       @unique @map("product_id")
  /// Score Serial Number (SSN): Unique identifier for this score
  /// Format: VS-{CATEGORY}-{SCORE}-{CONFIDENCE}-{DATE}
  /// Example: VS-ELE-089-92-20251003
  /// Enables tracking, verification, and blockchain integration
  ssn                   String                       @unique @map("ssn")
  /// Overall Veritas Score (0-100)
  /// Weighted average of 8 category scores
  /// - S Grade (95-100): Exceptional
  /// - A Grade (85-94): Excellent (often certified refurbished!)
  /// - B Grade (75-84): Good
  /// - C Grade (65-74): Fair
  /// - D Grade (50-64): Below Average
  /// - F Grade (0-49): Poor
  overallScore          Decimal                      @map("overall_score") @db.Decimal(5, 2)
  /// Confidence Level (0-100%)
  /// How reliable is this score based on data availability
  /// High confidence (85%+): Score is very accurate
  /// Medium confidence (65-84%): Score is reasonably accurate
  /// Low confidence (<65%): Limited data, use caution
  confidence            Decimal                      @map("confidence") @db.Decimal(5, 2)
  /// Data Quality Score (0-100%)
  /// Percentage of parameters with available data
  /// 100% = all 121 parameters evaluated
  /// <70% = significant missing data
  dataQualityScore      Decimal                      @map("data_quality_score") @db.Decimal(5, 2)
  calculatedAt          DateTime                     @default(now()) @map("calculated_at") @db.Timestamp(6)
  lastUpdatedAt         DateTime                     @updatedAt @map("last_updated_at") @db.Timestamp(6)
  nextUpdateDue         DateTime?                    @map("next_update_due") @db.Timestamp(6)
  calculationVersion    String                       @default("v2.0") @map("calculation_version") @db.VarChar(10)
  /// Array of parameter codes with missing data
  /// Used to identify areas for seller improvement
  /// Example: ["ST_RATING", "PQ_WARRANTY"]
  missingDataFields     String[]                     @default([]) @map("missing_data_fields")
  categories            VeritasCategory[]
  competitorComparisons VeritasCompetitorComparison?
  product               Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([overallScore(sort: Desc)], map: "idx_veritas_score_overall")
  @@index([productId])
  @@index([calculatedAt])
  @@index([confidence])
  @@map("veritas_scores")
}

/// Veritas Score Category - One of 8 Quality Dimensions
///
/// Each product is evaluated across 8 categories:
/// 1. PRODUCT_QUALITY (25%): Condition, authenticity, functionality
/// 2. SELLER_TRUST (20%): Reputation, response time, reliability
/// 3. MARKET_VALUE (15%): Price vs. market, discount, value
/// 4. SUSTAINABILITY (12%): Environmental impact, reuse benefit
/// 5. SECURITY_SAFETY (5%): Payment security, buyer protection
/// 6. USER_EXPERIENCE (5%): Listing quality, customer service
/// 7. PRODUCT_SPECIFICATION (13%): Tech specs, feature completeness
/// 8. COMPANY_PERFORMANCE (5%): Brand reputation, news sentiment
///
/// Category scores adapt based on product condition:
/// - NEW: Emphasize authenticity, warranty
/// - REFURBISHED: Emphasize certification, OEM parts
/// - USED: Emphasize actual condition vs. description
model VeritasCategory {
  id             String              @id @default(cuid())
  veritasScoreId String              @map("veritas_score_id")
  /// One of 8 category types (see enum below)
  categoryName   VeritasCategoryType @map("category_name")
  /// Category Score (0-100)
  /// Weighted average of all parameters in this category
  categoryScore  Decimal             @map("category_score") @db.Decimal(5, 2)
  /// Category Weight (0.00-1.00, sums to 1.00 across all categories)
  /// Product Quality: 0.25, Seller Trust: 0.20, etc.
  weight         Decimal             @map("weight") @db.Decimal(3, 2)
  /// Weighted Score = categoryScore × weight
  /// This contributes to the overall Veritas Score
  weightedScore  Decimal             @map("weighted_score") @db.Decimal(5, 2)
  /// Category Confidence (0-100%)
  /// Based on parameter availability and data quality
  confidence     Decimal             @map("confidence") @db.Decimal(5, 2)
  calculatedAt   DateTime            @default(now()) @map("calculated_at") @db.Timestamp(6)
  veritasScore   VeritasScore        @relation(fields: [veritasScoreId], references: [id], onDelete: Cascade)
  parameters     VeritasParameter[]

  @@index([veritasScoreId])
  @@index([categoryName])
  @@map("veritas_categories")
}

