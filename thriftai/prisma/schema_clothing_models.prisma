// =============================================================================
// VERITAS CLOTHING MODELS - 27-Factor Quality System
// =============================================================================
// Created: October 23, 2026
// Purpose: Clothing-specific data model for DTC brand search
//
// 10 Core Models:
// 1. Brand - Clothing brand profiles
// 2. ClothingProduct - Extends Product with clothing fields
// 3. ClothingReview - Reviews with fit/quality signals
// 4. ReturnEvent - Return tracking for fit/quality issues
// 5. EvidenceTag - Tagged evidence from reviews/returns
// 6. PriceSnapshot - Price history tracking
// 7. TrendSignal - Fashion trend signals
// 8. FactorScore - Individual factor scores (27 factors)
// 9. ProductScore - Pillar-level aggregated scores
// 10. ShopperProfile - Shopper fit preferences
// =============================================================================

/// Model 1: Brand - Clothing Brand Profile
///
/// Represents clothing brands (Everlane, Reformation, Allbirds, etc.)
/// Used for brand reputation scoring and trend tracking
model Brand {
  id                String    @id @default(cuid())
  name              String    @unique
  slug              String    @unique
  description       String?
  website           String?
  foundedYear       Int?
  
  // Brand Reputation (Factor 15)
  reputationScore   Int       @default(70) // 0-100
  sustainabilityRating String? // A-F from Good On You, etc.
  ethicsRating      String?   // Fair trade, transparency
  
  // Trend & Market Data
  trendRelevance    Int       @default(50) // 0-100
  priceRange        String?   // budget | mid | premium | luxury
  targetDemographic String?   // millennials, gen-z, etc.
  
  // Certifications
  certifications    String[]  @default([]) // GOTS, Fair Trade, etc.
  
  // Metadata
  logoUrl           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  products          ClothingProduct[]
  trendSignals      TrendSignal[]
  
  @@index([name])
  @@index([slug])
  @@index([reputationScore])
  @@map("brands")
}

/// Model 2: ClothingProduct - Clothing-Specific Product Data
///
/// Extends the base Product model with clothing-specific fields
/// Links to existing Tenant for B2B multi-tenancy
model ClothingProduct {
  id                String    @id @default(cuid())
  tenantId          String?   // B2B tenant (optional for marketplace)
  
  // Basic Info
  name              String
  brandId           String
  category          ClothingCategory
  subcategory       String?   // tee, blouse, jogger, etc.
  sku               String    @unique
  
  // Pricing
  currentPrice      Decimal   @db.Decimal(10, 2)
  originalPrice     Decimal?  @db.Decimal(10, 2)
  currency          String    @default("USD")
  
  // Clothing-Specific
  gender            ClothingGender
  sizes             String[]  // ["XS", "S", "M", "L", "XL", "2XL", "3XL"]
  colors            String[]  // ["Black", "Navy", "Heather Gray"]
  materials         Json      // {"cotton": 60, "polyester": 40}
  careInstructions  String?   // "Machine wash cold"
  
  // Fit Data (Factors 1-6)
  fitType           String?   // slim, regular, relaxed, oversized
  sizeConsistency   String    @default("unknown") // runs_small | true_to_size | runs_large
  
  // Quality Data (Factors 7-12)
  fabricQuality     String?   // premium | standard | budget
  constructionType  String?   // sewn | bonded | seamless
  durabilityRating  Int?      // 0-100
  
  // Style (Factors 13-19)
  style             String?   // classic, trendy, minimalist
  versatility       Int?      // 0-100
  trendCategory     String?   // timeless | seasonal | fast-fashion
  
  // Comfort (Factors 20-24)
  comfortRating     Int?      // 0-100 from reviews
  breathability     String?   // high | medium | low
  stretchLevel      String?   // none | slight | moderate | high
  
  // Sustainability (Factors 25-27)
  sustainabilityScore Int?    // 0-100
  recycledContent   Int?      // percentage
  organicCertified  Boolean   @default(false)
  
  // Availability
  isAvailable       Boolean   @default(true)
  stockBySize       Json?     // {"S": 10, "M": 5, "L": 0}
  
  // Images & Media
  images            String[]  @default([])
  primaryImageUrl   String?
  
  // Metadata
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  brand             Brand     @relation(fields: [brandId], references: [id])
  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
  reviews           ClothingReview[]
  returns           ReturnEvent[]
  evidenceTags      EvidenceTag[]
  priceSnapshots    PriceSnapshot[]
  factorScores      FactorScore[]
  productScore      ProductScore?
  
  @@index([tenantId])
  @@index([brandId])
  @@index([category])
  @@index([gender])
  @@index([currentPrice])
  @@index([isAvailable])
  @@map("clothing_products")
}

/// Model 3: ClothingReview - Reviews with Fit/Quality Signals
///
/// Enhanced reviews capturing clothing-specific feedback
/// Used by Evidence Agent to extract fit and quality signals
model ClothingReview {
  id                String    @id @default(cuid())
  productId         String
  
  // Review Content
  title             String?
  content           String
  rating            Int       // 1-5
  
  // Clothing-Specific Ratings
  fitRating         Int?      // 1-5: How well does it fit?
  qualityRating     Int?      // 1-5: Material/construction quality
  comfortRating     Int?      // 1-5: Comfort level
  styleRating       Int?      // 1-5: Style/appearance
  valueRating       Int?      // 1-5: Value for money
  
  // Fit Signals
  sizePurchased     String?   // "M", "L", etc.
  fitsAs            String?   // runs_small | true_to_size | runs_large
  heightCm          Int?      // Reviewer height
  weightKg          Int?      // Reviewer weight
  bodyType          String?   // slim, athletic, curvy, plus
  
  // Quality Signals
  wearDuration      String?   // "1 month", "6 months", "2 years"
  pillingObserved   Boolean?
  colorFading       Boolean?
  shrinkage         Boolean?
  
  // Review Metadata
  isVerifiedPurchase Boolean  @default(false)
  helpfulVotes      Int       @default(0)
  reviewerName      String?
  reviewDate        DateTime  @default(now())
  
  // Evidence Processing
  processed         Boolean   @default(false)
  processedAt       DateTime?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  product           ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  evidenceTags      EvidenceTag[]
  
  @@index([productId])
  @@index([rating])
  @@index([processed])
  @@index([reviewDate])
  @@map("clothing_reviews")
}

/// Model 4: ReturnEvent - Return Tracking
///
/// Tracks product returns with reasons
/// Critical for Factors 4 (Fit-related return rate) and 12 (Quality-related return rate)
model ReturnEvent {
  id                String    @id @default(cuid())
  productId         String
  
  // Return Details
  returnReason      ReturnReason
  returnCategory    ReturnCategory // fit | quality | style | other
  detailedReason    String?   // Free-form explanation
  
  // Product Details at Purchase
  sizePurchased     String?
  colorPurchased    String?
  purchasePrice     Decimal?  @db.Decimal(10, 2)
  purchaseDate      DateTime?
  returnDate        DateTime  @default(now())
  
  // Resolution
  resolutionType    String?   // refund | exchange | store_credit
  exchangedForSize  String?   // If exchanged for different size
  
  // Evidence Extraction
  processed         Boolean   @default(false)
  processedAt       DateTime?
  
  createdAt         DateTime  @default(now())
  
  // Relations
  product           ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  evidenceTags      EvidenceTag[]
  
  @@index([productId])
  @@index([returnCategory])
  @@index([returnDate])
  @@index([processed])
  @@map("return_events")
}

/// Model 5: EvidenceTag - Tagged Evidence from Reviews/Returns
///
/// Structured evidence extracted by Evidence Agent
/// Links to 27-factor taxonomy
model EvidenceTag {
  id                String    @id @default(cuid())
  productId         String
  
  // Source
  sourceType        EvidenceSource  // review | return | social | expert
  sourceId          String?   // Review ID or Return ID
  reviewId          String?
  returnId          String?
  
  // Factor Taxonomy
  factor            String    // e.g., "fit.true_to_size", "quality.fabric"
  pillar            FactorPillar
  
  // Evidence Signal
  signal            String    // e.g., "runs_small", "excellent_quality", "pilling"
  sentiment         Decimal   @db.Decimal(3, 2) // -1.0 to +1.0
  confidence        Decimal   @db.Decimal(3, 2) // 0.0 to 1.0
  
  // Context
  quote             String?   // Original text snippet
  metadata          Json?     // Additional context
  
  // Processing
  extractedBy       String    @default("evidence_agent") // agent | manual
  extractedAt       DateTime  @default(now())
  
  // Relations
  product           ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  review            ClothingReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  return            ReturnEvent?    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  
  @@index([productId])
  @@index([factor])
  @@index([pillar])
  @@index([extractedAt])
  @@map("evidence_tags")
}

/// Model 6: PriceSnapshot - Price History
///
/// Tracks pricing over time for Factor 14 (Price fairness)
/// Used by Price & Value Agent
model PriceSnapshot {
  id                String    @id @default(cuid())
  productId         String
  
  // Price Data
  price             Decimal   @db.Decimal(10, 2)
  originalPrice     Decimal?  @db.Decimal(10, 2)
  discountPercent   Int?      // 0-100
  
  // Market Context
  marketAvgPrice    Decimal?  @db.Decimal(10, 2)
  lowestCompPrice   Decimal?  @db.Decimal(10, 2)
  pricePosition     String?   // below_market | at_market | above_market
  
  // Snapshot Metadata
  snapshotDate      DateTime  @default(now())
  source            String    @default("api") // api | scrape | manual
  
  // Relations
  product           ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
  @@index([snapshotDate])
  @@map("price_snapshots")
}

/// Model 7: TrendSignal - Fashion Trend Data
///
/// Tracks trend relevance for Factor 17 (Trend relevance)
/// Used by Trend & Brand Agent
model TrendSignal {
  id                String    @id @default(cuid())
  brandId           String?
  
  // Trend Identification
  trendName         String    // e.g., "oversized_blazers", "Y2K_revival"
  trendCategory     String    // style | color | material | silhouette
  
  // Trend Metrics
  trendScore        Int       // 0-100: How hot is this trend?
  trendPhase        TrendPhase // emerging | peak | declining | classic
  
  // Geographic & Demo
  region            String?   // US, EU, global
  demographic       String?   // gen-z, millennials, etc.
  
  // Data Sources
  googleTrendsScore Int?      // 0-100
  socialMentions    Int?      // Count from Instagram, TikTok
  runwayAppearances Int?      // Fashion week mentions
  
  // Temporal
  detectedAt        DateTime  @default(now())
  peakDate          DateTime?
  
  // Relations
  brand             Brand?    @relation(fields: [brandId], references: [id])
  
  @@index([trendName])
  @@index([trendScore])
  @@index([detectedAt])
  @@map("trend_signals")
}

/// Model 8: FactorScore - Individual Factor Scores
///
/// Stores scores for each of the 27 factors
/// One record per product per factor
model FactorScore {
  id                String    @id @default(cuid())
  productId         String
  
  // Factor Identity
  factor            String    // e.g., "fit.true_to_size"
  pillar            FactorPillar
  
  // Score
  value             Decimal   @db.Decimal(5, 2) // 0-100
  weight            Int       // Weight in pillar (0-8 points)
  
  // Confidence
  evidenceCount     Int       @default(0)
  confidence        Confidence // high | medium | low | none
  
  // Calculation Metadata
  version           String    @default("v1.0")
  computedAt        DateTime  @default(now())
  computedBy        String    @default("scoring_engine")
  
  // Relations
  product           ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([productId, factor, version])
  @@index([productId])
  @@index([factor])
  @@index([pillar])
  @@map("factor_scores")
}

/// Model 9: ProductScore - Aggregated Pillar Scores
///
/// Overall product quality score with pillar breakdown
/// Used for ranking and display
model ProductScore {
  id                String    @id @default(cuid())
  productId         String    @unique
  
  // Overall Score
  overall           Int       // 0-100
  grade             String    // A+ to F
  
  // Pillar Scores (0-100 each)
  fit               Int?
  quality           Int?
  styleValue        Int?
  comfort           Int?
  sustainability    Int?
  
  // Confidence
  confidence        Confidence
  evidenceCount     Int       @default(0)
  
  // Factor Coverage
  factorsIncluded   String[]  @default([]) // List of factors with data
  factorsMissing    String[]  @default([]) // List of factors without data
  
  // Product State
  isNewLaunch       Boolean   @default(false) // <30 days old, low data
  
  // Calculation Metadata
  version           String    @default("v1.0")
  calculatedAt      DateTime  @default(now())
  nextUpdateDue     DateTime?
  
  // Relations
  product           ClothingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([overall])
  @@index([confidence])
  @@index([calculatedAt])
  @@map("product_scores")
}

/// Model 10: ShopperProfile - Shopper Fit Preferences
///
/// Stores shopper body measurements and fit preferences
/// Used for Personal Match scoring
model ShopperProfile {
  id                String    @id @default(cuid())
  userId            String?   @unique // Link to User if authenticated
  sessionId         String?   // Anonymous session
  
  // Body Measurements (optional)
  heightCm          Int?
  weightKg          Int?
  chestCm           Int?
  waistCm           Int?
  hipsCm            Int?
  
  // Fit Preferences
  preferredFit      String?   // slim | regular | relaxed | oversized
  sizePreferences   Json?     // {"tops": "M", "bottoms": "32"}
  bodyType          String?   // slim, athletic, curvy, plus
  
  // Style Preferences
  stylePreferences  String[]  @default([]) // minimalist, streetwear, etc.
  colorPreferences  String[]  @default([])
  
  // Purchase History
  purchaseCount     Int       @default(0)
  returnRate        Decimal?  @db.Decimal(3, 2) // 0.00-1.00
  avgOrderValue     Decimal?  @db.Decimal(10, 2)
  
  // Privacy
  isPublic          Boolean   @default(false)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([userId])
  @@index([sessionId])
  @@map("shopper_profiles")
}

// =============================================================================
// ENUMS
// =============================================================================

enum ClothingCategory {
  TOPS           // Shirts, blouses, tees, sweaters
  BOTTOMS        // Jeans, pants, shorts, skirts
  DRESSES        // All dresses
  OUTERWEAR      // Jackets, coats
  ACTIVEWEAR     // Gym, yoga, running
  UNDERWEAR      // Underwear, bras, socks
  SHOES          // All footwear
  ACCESSORIES    // Bags, hats, scarves
}

enum ClothingGender {
  WOMENS
  MENS
  UNISEX
  KIDS_BOYS
  KIDS_GIRLS
}

enum ReturnReason {
  TOO_SMALL
  TOO_LARGE
  POOR_FIT
  POOR_QUALITY
  NOT_AS_DESCRIBED
  COLOR_MISMATCH
  STYLE_DISLIKE
  DAMAGE_DEFECT
  WRONG_ITEM
  CHANGED_MIND
  OTHER
}

enum ReturnCategory {
  FIT
  QUALITY
  STYLE
  OTHER
}

enum EvidenceSource {
  REVIEW
  RETURN
  SOCIAL_MEDIA
  EXPERT_REVIEW
  MANUAL
}

enum FactorPillar {
  FIT
  QUALITY
  STYLE_VALUE
  COMFORT
  SUSTAINABILITY
}

enum TrendPhase {
  EMERGING
  PEAK
  DECLINING
  CLASSIC
}

enum Confidence {
  HIGH      // 85%+ evidence
  MEDIUM    // 65-84% evidence
  LOW       // <65% evidence
  NONE      // No data
}
