# Hosted development (Supabase "veritas-dev" project + Vercel Preview). Copy to .env.hosted.local (gitignored)
# and fill in the dev project's values. Never put production values here.
APP_ENV=development
ALLOW_HOSTED_DEV_DB=1
# Supabase dev project → Project settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<dev-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<dev-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
