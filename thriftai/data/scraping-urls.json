{
  "description": "URL templates for scraping product parameters from e-commerce websites",
  "version": "1.0.0",
  "categories": {
    "ELECTRONICS": {
      "sources": [
        {
          "name": "Apple Official",
          "baseUrl": "https://www.apple.com",
          "productPaths": {
            "iPhone": "/iphone/{model}/specs/",
            "iPad": "/ipad/{model}/specs/",
            "MacBook": "/macbook-{model}/specs/",
            "AppleWatch": "/apple-watch-{model}/specs/"
          },
          "selectors": {
            "specs": ".specs-list",
            "displaySize": "[data-spec='display-size']",
            "processor": "[data-spec='chip']",
            "storage": "[data-spec='storage']"
          }
        },
        {
          "name": "Best Buy",
          "baseUrl": "https://www.bestbuy.com",
          "searchUrl": "https://www.bestbuy.com/site/searchpage.jsp?st={query}",
          "selectors": {
            "specs": ".specifications-table",
            "brand": ".brand-name",
            "model": ".model-number"
          }
        },
        {
          "name": "Amazon",
          "baseUrl": "https://www.amazon.com",
          "searchUrl": "https://www.amazon.com/s?k={query}",
          "selectors": {
            "specs": "#productDetails_techSpec_section_1",
            "features": "#feature-bullets"
          }
        },
        {
          "name": "GSMArena (Mobile Specs)",
          "baseUrl": "https://www.gsmarena.com",
          "searchUrl": "https://www.gsmarena.com/results.php3?sQuickSearch=yes&sName={query}",
          "selectors": {
            "specs": "#specs-list",
            "display": "[data-spec='displaysize']",
            "camera": "[data-spec='cam1modules']"
          }
        }
      ]
    },
    "CLOTHING": {
      "sources": [
        {
          "name": "Nike",
          "baseUrl": "https://www.nike.com",
          "searchUrl": "https://www.nike.com/w?q={query}",
          "selectors": {
            "specs": ".product-info",
            "material": ".material-info",
            "care": ".care-instructions"
          }
        },
        {
          "name": "Zara",
          "baseUrl": "https://www.zara.com",
          "selectors": {
            "composition": ".composition",
            "care": ".care-info",
            "origin": ".origin-info"
          }
