        {
          "name": "Amazon Toys",
          "baseUrl": "https://www.amazon.com",
          "searchUrl": "https://www.amazon.com/s?k={query}&i=toys-and-games",
          "selectors": {
            "specs": "#productDetails_detailBullets_sections1",
            "age": ".age-range"
          }
        }
      ]
    }
  },
  "scraping_notes": {
    "rate_limiting": "Implement 1-2 second delays between requests to avoid being blocked",
    "user_agent": "Use realistic browser user agents to avoid detection",
    "rotating_proxies": "Consider using proxy rotation for large-scale scraping",
    "error_handling": "Gracefully handle 404s, timeouts, and rate limit errors",
    "caching": "Cache scraped data to avoid re-fetching same products",
    "respect_robots_txt": "Always check and respect robots.txt policies",
    "legal_compliance": "Ensure scraping complies with website terms of service"
  },
  "implementation_example": {
    "puppeteer": "npm install puppeteer",
    "cheerio": "npm install cheerio",
    "axios": "npm install axios",
    "script": "scripts/scrape-from-urls.ts"
  }
}
