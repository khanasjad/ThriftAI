# Copy secrets into .env.development.local (dev) or Vercel env vars (prod).
# Non-secret defaults live in .env.development / .env.production.

# --- required ---
APP_ENV=development                 # development | production
DATABASE_URL="postgresql://USER@localhost:5432/veritas_dev?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/veritas_dev?schema=public"   # Supabase: non-pooled URL
ANTHROPIC_API_KEY=""
NEXTAUTH_SECRET=""                  # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
SPEND_CAP_USD=15                    # harness refuses new agent runs past this total
# Use the intent agent (live Claude call) on searches. The code parser always runs. 1 = on.
SEARCH_INTENT_AGENT=0

# --- optional ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
LLM_MODE=live                       # live | replay | mock
LLM_RECORD=0                        # 1 = record live responses to fixtures/llm (for replay)
VERITAS_MODEL_AGENT=claude-haiku-5-5
VERITAS_MODEL_ROUTER=claude-haiku-5-5
VERITAS_MODEL_JUDGE=claude-opus-5-5
RESEND_API_KEY=""                   # pilot emails
GOOGLE_CLIENT_ID=""                 # Google sign-in (both required to enable)
GOOGLE_CLIENT_SECRET=""
LANGFUSE_PUBLIC_KEY=""              # optional trace export
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
