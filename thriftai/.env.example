# Copy secrets into .env.development.local (dev) or Vercel env vars (prod).
# Non-secret defaults live in .env.development / .env.production.

# --- required ---
APP_ENV=development                 # development | production
DATABASE_URL="postgresql://USER@localhost:5432/veritas_dev?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/veritas_dev?schema=public"   # Supabase: non-pooled URL
ANTHROPIC_API_KEY=""
NEXTAUTH_SECRET=""                  # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
SPEND_CAP_USD=15                    # harness refuses new agent runs past this total
# Shopkeeper agent on searches (live Claude call, ~$0.001 per turn). 0 = code-only questions.
SEARCH_AGENT=1

# --- optional ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
LLM_MODE=live                       # live | replay | mock
LLM_RECORD=0                        # 1 = record live responses to fixtures/llm (for replay)
VERITAS_MODEL_AGENT=claude-haiku-5-5
VERITAS_MODEL_ROUTER=claude-haiku-5-5
VERITAS_MODEL_JUDGE=claude-opus-5-5
RESEND_API_KEY=""                   # pilot emails
GOOGLE_CLIENT_ID=""                 # Google sign-in (both required to enable)
GOOGLE_CLIENT_SECRET=""
LANGFUSE_PUBLIC_KEY=""              # optional trace export
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Spend cap window: total (dev, all-time) or month (production, since the 1st, UTC)
SPEND_CAP_WINDOW=total
# Direct (non-pooled) database connection, used by migrations. Required in production (Supabase "direct" URL).
DIRECT_URL=
# Secret Vercel cron sends to /api/cron/nightly (at least 24 characters). Required in production.
CRON_SECRET=
# Show the fictional demo store in production (default off)
DEMO_STORE=0
