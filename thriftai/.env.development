# Development defaults (committed, no secrets). Secrets go in .env.development.local.
APP_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Claude (models chosen 2026-10-24: Haiku 5.5 for agents/router, Opus 5.5 for the judge)
LLM_MODE=live
VERITAS_MODEL_AGENT=claude-haiku-5-5
VERITAS_MODEL_ROUTER=claude-haiku-5-5
VERITAS_MODEL_JUDGE=claude-opus-5-5
SPEND_CAP_USD=15
