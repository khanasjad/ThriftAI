# AI Services Configuration

# Service URLs
CATALOG_EXTRACTOR_URL=http://localhost:8085
THEME_ENGINE_URL=http://localhost:8086
AI_LOAD_BALANCER_URL=http://localhost:8087

# Model Cache Directory
MODEL_CACHE_DIR=./models

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GPU Configuration
CUDA_VISIBLE_DEVICES=0

# Performance Settings
MAX_WORKERS=4
BATCH_SIZE=8
CACHE_TTL=3600

# Security
API_SECRET_KEY=your_secret_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ai-services.log