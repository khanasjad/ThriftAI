package com.projectai.service;

import com.projectai.models.Product;
import com.projectai.repository.ProductRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.*;
import java.util.stream.Collectors;

@Service
public class SmartFallbackSearchService {

    @Autowired
    private ProductRepository productRepository;

    public SmartSearchResult performIntelligentSearch(String query, String userId) {
        SmartSearchResult result = new SmartSearchResult();

        // Always expand vintage/designer queries
        List<Product> products = expandAndSearch(query);
        result.setProducts(products);
        result.setTotalElements(products.size());

        // Generate AI insights based on query
        result.setSearchInsights(generateInsights(query, products));
        result.setSmartSuggestions(generateSmartSuggestions(query));
        result.setExpandedQueries(generateExpandedQueries(query));

        // If no results, provide intelligent fallbacks
        if (products.isEmpty()) {
            result.setNoResultsMessage("🤖 No exact matches found, but here are similar items you might like!");
            result.setFallbackRecommendations(getFallbackRecommendations(query));
            result.setShowSimilarItems(true);
        }

        return result;
    }

    private List<Product> expandAndSearch(String query) {
        Set<Product> allResults = new HashSet<>();
        String lowerQuery = query.toLowerCase();

        // Direct search
        allResults.addAll(productRepository.findByNameContainingIgnoreCase(query));
        allResults.addAll(productRepository.findByDescriptionContainingIgnoreCase(query));
        allResults.addAll(productRepository.findByBrandContainingIgnoreCase(query));

        // Smart expansions for vintage
        if (lowerQuery.contains("vintage")) {
            allResults.addAll(productRepository.findByNameContainingIgnoreCase("retro"));
            allResults.addAll(productRepository.findByNameContainingIgnoreCase("classic"));
            allResults.addAll(productRepository.findByDescriptionContainingIgnoreCase("vintage"));
            allResults.addAll(productRepository.findByDescriptionContainingIgnoreCase("80s"));
            allResults.addAll(productRepository.findByDescriptionContainingIgnoreCase("90s"));
        }

        // Smart expansions for designer
        if (lowerQuery.contains("designer")) {
            allResults.addAll(productRepository.findByBrandContainingIgnoreCase("gucci"));
            allResults.addAll(productRepository.findByBrandContainingIgnoreCase("prada"));
            allResults.addAll(productRepository.findByBrandContainingIgnoreCase("chanel"));
            allResults.addAll(productRepository.findByNameContainingIgnoreCase("luxury"));
            allResults.addAll(productRepository.findByDescriptionContainingIgnoreCase("designer"));
        }

        // Category-based expansion
        if (lowerQuery.contains("jacket") || lowerQuery.contains("coat")) {
            allResults.addAll(productRepository.findByCategoryIgnoreCase("Clothing"));
        }

        if (lowerQuery.contains("bag") || lowerQuery.contains("handbag")) {
            allResults.addAll(productRepository.findByCategoryIgnoreCase("Accessories"));
        }

        return allResults.stream()
            .filter(p -> p.getIsAvailable())
            .sorted((a, b) -> calculateRelevanceScore(b, query) - calculateRelevanceScore(a, query))
            .limit(20)
            .collect(Collectors.toList());
    }

    private int calculateRelevanceScore(Product product, String query) {
        int score = 0;
        String lowerQuery = query.toLowerCase();
        String productText = (product.getName() + " " +
                            (product.getDescription() != null ? product.getDescription() : "") + " " +
                            (product.getBrand() != null ? product.getBrand() : "")).toLowerCase();

        // Exact name matches get highest score
        if (product.getName().toLowerCase().contains(lowerQuery)) {
            score += 10;
        }

        // Brand matches
        if (product.getBrand() != null && product.getBrand().toLowerCase().contains(lowerQuery)) {
            score += 8;
        }

        // Description matches
        if (product.getDescription() != null && product.getDescription().toLowerCase().contains(lowerQuery)) {
            score += 5;
        }

        // Special scoring for vintage/designer
        if (lowerQuery.contains("vintage") && productText.contains("vintage")) {
            score += 15;
        }

        if (lowerQuery.contains("designer") && (productText.contains("gucci") || productText.contains("luxury"))) {
            score += 12;
        }

        return score;
    }

    private List<String> generateInsights(String query, List<Product> products) {
        List<String> insights = new ArrayList<>();
        String lowerQuery = query.toLowerCase();

        if (lowerQuery.contains("vintage")) {
            insights.add("🕰️ Showing authentic vintage pieces from our curated collection");
            if (products.stream().anyMatch(p -> p.getName().toLowerCase().contains("80s") ||
                                              p.getName().toLowerCase().contains("90s"))) {
                insights.add("📅 Found items from the 80s and 90s era");
            }
        }

        if (lowerQuery.contains("designer")) {
            insights.add("✨ Including premium and luxury designer pieces");
            long designerCount = products.stream()
                .filter(p -> p.getBrand() != null &&
                           (p.getBrand().toLowerCase().contains("gucci") ||
                            p.getBrand().toLowerCase().contains("prada")))
                .count();
            if (designerCount > 0) {
                insights.add(String.format("👑 Found %d authentic designer items", designerCount));
            }
        }

        if (products.size() > 0) {
            double avgPrice = products.stream()
                .filter(p -> p.getPrice() != null)
                .mapToDouble(Product::getPrice)
                .average()
                .orElse(0);

            if (avgPrice > 0) {
                insights.add(String.format("💰 Average price: $%.0f - from budget to luxury options", avgPrice));
            }
        }

        if (insights.isEmpty()) {
            insights.add("🔍 AI-powered search found these relevant items for you");
        }

        return insights;
    }

    private List<String> generateSmartSuggestions(String query) {
        List<String> suggestions = new ArrayList<>();
        String lowerQuery = query.toLowerCase();

        if (lowerQuery.contains("vintage")) {
            suggestions.addAll(Arrays.asList(
                "vintage leather jackets",
                "retro band t-shirts",
                "classic denim pieces",
                "vintage designer handbags",
                "80s windbreakers"
            ));
        } else if (lowerQuery.contains("designer")) {
            suggestions.addAll(Arrays.asList(
                "designer handbags",
                "luxury watches",
                "premium sneakers",
                "designer sunglasses",
                "authentic luxury items"
            ));
        } else {
            suggestions.addAll(Arrays.asList(
                "trending items",
                "popular brands",
                "new arrivals",
                "best sellers",
                "curated picks"
            ));
        }

        return suggestions.stream().limit(5).collect(Collectors.toList());
    }

    private List<String> generateExpandedQueries(String query) {
        List<String> expanded = new ArrayList<>();
        String lowerQuery = query.toLowerCase();

        expanded.add(query); // Original query

        if (lowerQuery.contains("vintage")) {
            expanded.add(query.replace("vintage", "retro"));
            expanded.add(query.replace("vintage", "classic"));
            expanded.add("authentic " + query);
        }

        if (lowerQuery.contains("designer")) {
            expanded.add(query.replace("designer", "luxury"));
            expanded.add(query.replace("designer", "premium"));
            expanded.add("authentic " + query);
        }

        return expanded.stream().distinct().limit(4).collect(Collectors.toList());
    }

    private List<Product> getFallbackRecommendations(String query) {
        String lowerQuery = query.toLowerCase();
        List<Product> fallbacks = new ArrayList<>();

        // If searching for vintage, show all vintage items
        if (lowerQuery.contains("vintage")) {
            fallbacks.addAll(productRepository.findAll().stream()
                .filter(p -> p.getName().toLowerCase().contains("vintage") ||
                           (p.getDescription() != null && p.getDescription().toLowerCase().contains("vintage")))
                .limit(8)
                .collect(Collectors.toList()));
        }

        // If searching for designer, show luxury brands
        if (lowerQuery.contains("designer") && fallbacks.size() < 5) {
            fallbacks.addAll(productRepository.findAll().stream()
                .filter(p -> p.getBrand() != null &&
                           (p.getBrand().toLowerCase().contains("gucci") ||
                            p.getBrand().toLowerCase().contains("nike")))
                .limit(6)
                .collect(Collectors.toList()));
        }

        // General fallback - show popular items
        if (fallbacks.size() < 3) {
            fallbacks.addAll(productRepository.findByIsAvailableTrue().stream()
                .limit(10)
                .collect(Collectors.toList()));
        }

        return fallbacks.stream().distinct().limit(8).collect(Collectors.toList());
    }

    // Result class
    public static class SmartSearchResult {
        private List<Product> products = new ArrayList<>();
        private int totalElements;
        private List<String> searchInsights = new ArrayList<>();
        private List<String> smartSuggestions = new ArrayList<>();
        private List<String> expandedQueries = new ArrayList<>();
        private String noResultsMessage;
        private List<Product> fallbackRecommendations = new ArrayList<>();
        private boolean showSimilarItems = false;

        // Getters and setters
        public List<Product> getProducts() { return products; }
        public void setProducts(List<Product> products) { this.products = products; }
        public int getTotalElements() { return totalElements; }
        public void setTotalElements(int totalElements) { this.totalElements = totalElements; }
        public List<String> getSearchInsights() { return searchInsights; }
        public void setSearchInsights(List<String> searchInsights) { this.searchInsights = searchInsights; }
        public List<String> getSmartSuggestions() { return smartSuggestions; }
        public void setSmartSuggestions(List<String> smartSuggestions) { this.smartSuggestions = smartSuggestions; }
        public List<String> getExpandedQueries() { return expandedQueries; }
        public void setExpandedQueries(List<String> expandedQueries) { this.expandedQueries = expandedQueries; }
        public String getNoResultsMessage() { return noResultsMessage; }
        public void setNoResultsMessage(String noResultsMessage) { this.noResultsMessage = noResultsMessage; }
        public List<Product> getFallbackRecommendations() { return fallbackRecommendations; }
        public void setFallbackRecommendations(List<Product> fallbackRecommendations) { this.fallbackRecommendations = fallbackRecommendations; }
        public boolean isShowSimilarItems() { return showSimilarItems; }
        public void setShowSimilarItems(boolean showSimilarItems) { this.showSimilarItems = showSimilarItems; }
    }
}